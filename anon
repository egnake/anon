            esac
        done
    }

    local stat=""
    while true; do
        local main_opts=("Load Security Profile" "Custom Module Configuration" "Live Dashboard" "System Status" "System Update" "APPLY & START" "Exit")
        interactive_menu "MAIN MENU:" "${main_opts[@]}"
        stat=""
        case $SELECTED_INDEX in
            0)
                local prof_opts=("Paranoia Mode  ─  Max Security" "Quick Surf  ─  Fast Anonymity" "Pentest Mode  ─  Offensive" "Darknet Explorer  ─  Tor + I2P" "Physical Lockdown  ─  Anti-Forensics" "The Ghost  ─  Ultimate (All Features)" "◀ Back")
                interactive_menu "SELECT SECURITY PROFILE:" "${prof_opts[@]}"
                local i
                for i in "${!choices[@]}"; do choices[i]=""; done
                case $SELECTED_INDEX in
                    0) for i in 0 1 2 4 5 6 7 8 12 14 16 17 18 21; do choices[$i]="✓"; done; stat="◆ Loaded: Paranoia Mode" ;;
                    1) for i in 2 7 17; do choices[$i]="✓"; done; stat="◆ Loaded: Quick Surf" ;;
                    2) for i in 0 2 4 6 8 10 11 16; do choices[$i]="✓"; done; stat="◆ Loaded: Pentest Mode" ;;
                    3) for i in 2 13 15; do choices[$i]="✓"; done; stat="◆ Loaded: Darknet Explorer" ;;
                    4) for i in 0 1 9 12 14 20; do choices[$i]="✓"; done; stat="◆ Loaded: Physical Lockdown" ;;
                    5) for i in 0 1 2 4 5 6 7 8 9 10 11 12 14 15 16 17 18 20 21; do choices[$i]="✓"; done; stat="◆ Loaded: The Ghost (Ultimate)" ;;
                    6) stat="" ;;
                esac
                ;;
            1) interactive_toggles ;;
            2) dashboard ;;
            3)
                clear
                banner
                reload_state
                status
                echo -e "  ${DIM}Press any key to return...${RESET}"
                read -rsn1
                ;;
            4) update; exit 0 ;;
            5)
                execute_modules
                if ! operations_loop; then
                    continue
                fi
                ;;
            6) clear; exit 0 ;;
        esac
    done
}

stop(){
    local non_fatal="${1:-}"
    reload_state
    local active_cnt
    active_cnt="$(count_active_modules)"

    if [[ "$active_cnt" -gt 0 ]]; then
        local idx mod_name mod_var
        for idx in "${STOP_ORDER[@]}"; do
            reload_state
            mod_name="${MOD_NAMES[$idx]}"
            mod_var="${mod_name}_status"
            if [[ "${!mod_var:-Disable}" == "Enable" ]]; then
                _stop_module "$mod_name"
            fi
        done
    else
        if [[ "$non_fatal" == "non_fatal" ]]; then
            warn "No features are currently active."
        else
            err "No features are active. (Run to activate '${GREEN}sudo anon --start${RESET}')"
        fi
    fi
}

