clean_meta() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        echo -ne "  ${YELLOW}Enter file or directory path to sanitize:${RESET} "
        read -r target
    fi
    if [[ -n "$target" ]]; then
        "${BASE_DIR}/assets/scripts/metadata_cleaner" "$target"
    else
        err "No target path specified for metadata cleaning."
    fi
    exit 0
}

help() {
    msg "Usage : sudo anon ${GREEN}[option]${RESET}

 ${GREEN}--start      :${RESET}   It will make backups and start the program.
 ${GREEN}--stop       :${RESET}   Closes the program using a backup.
 ${GREEN}--status     :${RESET}   Provides information about IP address and working status.
 ${GREEN}--dashboard  :${RESET}   Opens a live real-time monitoring dashboard.
 ${GREEN}--browser    :${RESET}   Launches a disposable secure browser session.
 ${GREEN}--audit      :${RESET}   Executes an instant deep IP and DNS leak audit.
 ${GREEN}--clean-meta :${RESET}   Sanitizes metadata from files/folders (EXIF/GPS/tags) via MAT2/ExifTool.
 ${GREEN}--panic      :${RESET}   Emergency lockdown: immediately severs network, kills processes, and sanitizes RAM.
 ${GREEN}--fix        :${RESET}   Used to repair the system in case of a possible bug.
 ${GREEN}--update     :${RESET}   Automatically downloads and installs the latest version.
 ${GREEN}--help       :${RESET}   This shows the menu."
}

main() {
    if [[ "$#" -eq 0 ]]; then
        start
        exit 0
    fi

    case "$1" in
        --[sS][tT][aA][rR][tT]|-[sS][tT]) cli_start ;;
        --[sS][tT][oO][pP]|-[sS][pP]) stop ;;
        --[sS][tT][aA][tT][uU][sS]|-[sS][sS]) status ;;
        --[dD][aA][sS][hH][bB][oO][aA][rR][dD]|-[dD]) dashboard ;;
        --[bB][rR][oO][wW][sS][eE][rR]|-[bB]) browser ;;
        --[aA][uU][dD][iI][tT]|-[aA]) audit ;;
        --[cC][lL][eE][aA][nN]-[mM][eE][tT][aA]|-[cC][mM]) shift; clean_meta "${1:-}" ;;
        --[pP][aA][nN][iI][cC]|-[pP]) panic ;;
        --[fF][iI][xX]|-[fF]) fix ;;
        --[uU][pP][dD][aA][tT][eE]|-[uU]) update ;;
        --[hH][eE][lL][pP]|-[hH]) help; exit 0 ;;
        *)
            warn "Anon: Invalid option ${RED}'$1'${RESET}"
            info "Run ${GREEN}'anon --help'${RESET} parameter for more information."
            exit 1
            ;;
    esac
}

main "${@}"
