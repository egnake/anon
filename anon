    if [[ ! -f "$BACKUPDIR/anon_fix_backups.tar.gz" ]]; then
        get_backups
    fi

    local -a choices=()

    interactive_menu() {
        local title="$1"
        shift
        local opts=("$@")
        local selected=0
        local action active_count

        tput civis 2>/dev/null || true
        while true; do
            clear
            banner
            draw_line
            emptybox
            boxline "${BOLD}${CYAN}  $title${RESET}"
            emptybox
            draw_sep

            local i
            for i in "${!opts[@]}"; do
                if [[ $i -eq $selected ]]; then
                    boxline "${BOLD}${GREEN}  ▸ ${opts[$i]}${RESET}"
                else
                    boxline "${DIM}    ${opts[$i]}${RESET}"
                fi
            done

            draw_sep
            emptybox
            [[ -n "$stat" ]] && boxline "${YELLOW}  ◆ $stat${RESET}"
            active_count="$(count_active_modules)"
            if [[ "$active_count" -gt 0 ]] 2>/dev/null; then
                boxline "${GREEN}  ● ${active_count} module(s) active${RESET}"
            fi
            boxline "${DIM}  ↑↓/jk Navigate  ⏎ Select  q Quit${RESET}"
            emptybox
            draw_end

            action=$(_read_nav_key) || continue
            case "$action" in
                UP)
                    ((selected--))
                    (( selected < 0 )) && selected=$((${#opts[@]} - 1))
                    ;;
                DOWN)
                    ((selected++))
                    (( selected >= ${#opts[@]} )) && selected=0
                    ;;
                SELECT) break ;;
                QUIT)
                    tput cnorm 2>/dev/null || true
                    clear
                    exit 0
                    ;;
            esac
        done
        tput cnorm 2>/dev/null || true
        SELECTED_INDEX=$selected
    }

    interactive_toggles() {
        local -a visual_order=("${NET_CAT_INDICES[@]}" "${OBF_CAT_INDICES[@]}" "${DEF_CAT_INDICES[@]}")
        local total_items=${#visual_order[@]}
        local cursor=0
        local action

        tput civis 2>/dev/null || true
        while true; do
            local current_idx=-1
            if [[ $cursor -lt $total_items ]]; then
                current_idx=${visual_order[$cursor]}
            fi

            clear
            banner
            draw_line
            emptybox
            boxline "${BOLD}${CYAN}  CUSTOM MODULE CONFIGURATION (${total_items} Modules)${RESET}"
            emptybox
            draw_sep

            _render_cat() {
                local heading="$1"
                shift
                boxline "$heading"
                local idx mark
                for idx in "$@"; do
                    mark="${RED}✗${RESET}"
                    [[ "${choices[$idx]:-}" == "✓" ]] && mark="${GREEN}✓${RESET}"
                    if [[ $idx -eq $current_idx ]]; then
                        boxline "${BOLD}${CYAN}  ▸ [${mark}${BOLD}${CYAN}] ${MOD_LABELS[$idx]}${RESET}"
                    else
                        boxline "    [${mark}] ${MOD_LABELS[$idx]}"
                    fi
                done
