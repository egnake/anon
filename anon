# Check dependencies function
dep_check() {
    local missing_pkgs=()
    local apt_pkgs=""
    local cmd

    for cmd in "$@"; do
        if ! command -v "$cmd" &> /dev/null; then
            warn "$cmd: could not be found."
            if [[ "$cmd" == "sdmem" ]]; then
                apt_pkgs="$apt_pkgs secure-delete"
            else
                apt_pkgs="$apt_pkgs $cmd"
            fi
            missing_pkgs+=("$cmd")
        fi
    done

    if [[ ${#missing_pkgs[@]} -gt 0 ]]; then
        echo -ne "\n ${CYAN}ℹ INFO:${RESET} Some required dependencies are missing: ${BOLD}${missing_pkgs[*]}${RESET}\n"
        local choice="Y"
        if [[ -t 0 ]]; then
            echo -ne " ${YELLOW}➤ Do you want Anon to automatically install them for you? (Y/n): ${RESET}"
            read -r choice
        fi
        case "$choice" in
          y|Y|"" )
            echo -e "\n ${CYAN}ℹ INFO:${RESET} Installing missing packages..."
            if command -v apt-get &>/dev/null; then
                apt-get update
                DEBIAN_FRONTEND=noninteractive apt-get install -y $apt_pkgs
            else
                err "apt-get is unavailable. Please install missing packages manually: ${missing_pkgs[*]}"
            fi
            for cmd in "$@"; do
                if ! command -v "$cmd" &> /dev/null; then
                    err "Failed to install $cmd. Please install it manually."
                fi
            done
            msg "All dependencies installed successfully!\n"
            ;;
          * )
            err "Dependencies are required to run Anon. Exiting."
            ;;
        esac
    fi
}

