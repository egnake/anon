_tui_dims() {
    local width inner pad
    width=$(tput cols 2>/dev/null || echo 80)
    (( width < 20 )) && width=20
    inner=$(( width - 4 ))
    (( inner > 72 )) && inner=72
    (( inner < 16 )) && inner=16
    pad=$(( (width - inner - 2) / 2 ))
    (( pad < 0 )) && pad=0
    echo "$width $inner $pad"
}

draw_line() {
    local width inner pad
    read -r width inner pad <<< "$(_tui_dims)"
    printf "%${pad}s${DIM}╔" ""
    printf '═%.0s' $(seq 1 "$inner")
    printf "╗${RESET}\n"
}

draw_end() {
    local width inner pad
    read -r width inner pad <<< "$(_tui_dims)"
    printf "%${pad}s${DIM}╚" ""
    printf '═%.0s' $(seq 1 "$inner")
    printf "╝${RESET}\n"
}

draw_sep() {
    local width inner pad
    read -r width inner pad <<< "$(_tui_dims)"
    printf "%${pad}s${DIM}║" ""
    printf '─%.0s' $(seq 1 "$inner")
    printf "║${RESET}\n"
}

boxline() {
    local text="$1"
    local width inner pad
    read -r width inner pad <<< "$(_tui_dims)"

    local stripped
    stripped=$(echo -e "$text" | sed 's/\x1b\[[0-9;]*m//g')
    local tlen=${#stripped}
    local max_tlen=$(( inner - 1 ))
    if (( tlen > max_tlen )); then
        # Fallback truncation without breaking ANSI reset
        text="${stripped:0:$((max_tlen - 1))}…"
        tlen=${#text}
    fi
    local rpad=$(( inner - tlen - 1 ))
    (( rpad < 0 )) && rpad=0

    printf "%${pad}s${DIM}║${RESET} " ""
    echo -ne "$text"
    printf "%${rpad}s${DIM}║${RESET}\n" ""
}

emptybox() {
    local width inner pad
    read -r width inner pad <<< "$(_tui_dims)"
    printf "%${pad}s${DIM}║%${inner}s║${RESET}\n" "" ""
}

_read_nav_key() {
    local key="" seq=""
    IFS= read -rsn1 key || return 1
    if [[ "$key" == $'\x1b' ]]; then
        IFS= read -rsn2 -t 0.05 seq || seq=""
        case "$seq" in
            "[A") echo "UP" ;;
            "[B") echo "DOWN" ;;
            *) echo "ESC" ;;
        esac
    elif [[ "$key" == "" || "$key" == " " ]]; then
        echo "SELECT"
    elif [[ "$key" == "k" || "$key" == "K" ]]; then
        echo "UP"
    elif [[ "$key" == "j" || "$key" == "J" ]]; then
        echo "DOWN"
    elif [[ "$key" == "a" || "$key" == "A" ]]; then
        echo "ALL"
    elif [[ "$key" == "q" || "$key" == "Q" ]]; then
        echo "QUIT"
    else
        echo "OTHER"
    fi
}

start(){
