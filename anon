cli_start() {
    dep_check tar tor curl sdmem obfs4proxy macchanger proxychains4 rfkill i2pd
    if [[ ! -f "$BACKUPDIR/anon_fix_backups.tar.gz" ]]; then
        get_backups
    fi

    reload_state
    local enabled_count
    enabled_count="$(count_active_modules)"

    if [[ "$enabled_count" -gt 0 ]]; then
        info "Starting Anon with saved module configuration..."
        local idx mod_name mod_stat
        for idx in "${EXEC_ORDER[@]}"; do
            reload_state
            mod_name="${MOD_NAMES[$idx]}"
            mod_stat="${mod_name}_status"
            if [[ "${!mod_stat:-Disable}" == "Enable" ]]; then
                if _is_module_live "$mod_name"; then
                    info "$mod_name is already active; skipping duplicate start."
                    continue
                fi
                printf -v "$mod_stat" '%s' "Disable"
                _start_module "$mod_name"
            fi
        done
    else
        info "No active modules found in saved config. Activating default security profile (Tor + Kill Switch)..."
        _start_module "ip_changer"
        _start_module "kill_switch"
    fi

    msg "Anon started successfully in non-interactive mode."
    status
    exit 0
}

update() {
    info "Starting Anon Self-Update..."
    if ! command -v unzip &> /dev/null; then
        warn "unzip is not installed. Installing..."
        if command -v apt-get &>/dev/null; then
            apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y unzip
        fi
    fi

    (
        local tmp_dir
        tmp_dir=$(mktemp -d)
        trap 'rm -rf "$tmp_dir"' EXIT INT TERM
        info "Downloading latest release from GitHub..."
        if curl -fsSL https://github.com/egnake/anon/archive/refs/heads/main.zip -o "$tmp_dir/anon.zip" && unzip -tq "$tmp_dir/anon.zip" &>/dev/null; then
            info "Extracting..."
            unzip -q "$tmp_dir/anon.zip" -d "$tmp_dir"
            if [[ -d "$tmp_dir/anon-main" ]]; then
                cd "$tmp_dir/anon-main" || exit 1
                info "Running make reinstall..."
                make reinstall
                msg "Anon has been successfully updated to the latest version!"
                info "Please restart Anon by typing 'sudo anon'"
            else
                err "Corrupted update archive: anon-main directory not found."
            fi
        else
            err "Failed to download or verify the update archive."
        fi
    ) || exit 1
    exit 0
}

panic() {
    source "${BASE_DIR}/assets/scripts/emergency_panic"
    trigger_panic
    exit 0
}

audit() {
