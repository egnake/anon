                direct_ip=$(curl -s --max-time 5 https://api.ipify.org 2>/dev/null || echo "Offline")
                echo "UNSECURE|$direct_ip" > "$status_file"
            fi
            sleep 5
        done
    ) &
    local bg_pid=$!

    while true; do
        clear
        banner
        draw_line
        emptybox
        boxline "${BOLD}${MAGENTA}  ◈ LIVE DASHBOARD${RESET}"
        emptybox
        draw_sep
        
        source "$SRCDIR/sources/config"
        
        # Read async network status
        local net_status
        net_status=$(cat "$status_file" 2>/dev/null || echo "WAITING")
        local net_state="${net_status%%|*}"
        local net_ip="${net_status##*|}"
        
        if [[ "$net_state" == "SECURE_TOR" ]]; then
            boxline "${GREEN}  ● Network    ${BOLD}SECURE${RESET}${GREEN} (Tor Active)${RESET}"
            boxline "${CYAN}  ● Exit IP    ${YELLOW}${net_ip}${RESET}"
        elif [[ "$net_state" == "SECURE_SLOW" ]]; then
            boxline "${YELLOW}  ● Network    ${BOLD}SECURE${RESET}${YELLOW} (Routing / High Latency)${RESET}"
            boxline "${CYAN}  ● Exit IP    ${YELLOW}Hidden (Tor Encrypted)${RESET}"
        elif [[ "$net_state" == "SECURE_I2P" ]]; then
            boxline "${GREEN}  ● Network    ${BOLD}SECURE${RESET}${GREEN} (I2P Router Active)${RESET}"
            boxline "${CYAN}  ● Exit IP    ${YELLOW}Hidden (I2P)${RESET}"
        elif [[ "$net_state" == "WAITING" ]]; then
            boxline "${CYAN}  ● Network    ${BOLD}SCANNING...${RESET}"
            boxline "${CYAN}  ● Exit IP    ${YELLOW}Detecting...${RESET}"
        else
            boxline "${RED}  ○ Network    ${BOLD}UNSECURE${RESET}${RED} (Direct)${RESET}"
            boxline "${CYAN}  ● IP         ${YELLOW}${net_ip}${RESET}"
        fi
        
        # Traffic stats
        local iface
        iface=$(ip route 2>/dev/null | grep default | awk '{print $5}' | head -n 1)
        if [[ -n "$iface" ]] && [[ -f "/sys/class/net/$iface/statistics/rx_bytes" ]]; then
            local rx=$(cat /sys/class/net/$iface/statistics/rx_bytes)
            local tx=$(cat /sys/class/net/$iface/statistics/tx_bytes)
            local rx_mb=$(awk "BEGIN {printf \"%.1f\", $rx/1048576}")
            local tx_mb=$(awk "BEGIN {printf \"%.1f\", $tx/1048576}")
            boxline "${CYAN}  ● Traffic    ${GREEN}↑${tx_mb}MB ${CYAN}↓${rx_mb}MB${RESET}${DIM} on ${iface}${RESET}"
        fi
        
        draw_sep
        boxline "${BOLD}${WHITE}  ACTIVE MODULES:${RESET}"
        emptybox
        
        local mod_line=""
        local count=0
        
        print_mod() {
            if [[ "$2" == "Enable" ]]; then
                mod_line+="${GREEN}■${RESET}$1  "
                ((count++))
            fi
        }
        
        print_mod "MITM " "$anti_mitm_status"
        print_mod "VLOG " "$volatile_logging_status"
        print_mod "IP   " "$ip_changer_status"
        print_mod "DNS  " "$dns_changer_status"
        print_mod "MAC  " "$mac_changer_status"
        print_mod "TZ   " "$timezone_changer_status"
        print_mod "HOST " "$hostname_changer_status"
        print_mod "BRWS " "$browser_anonymization_status"
        print_mod "OS   " "$os_obfuscation_status"
        print_mod "BT   " "$bluetooth_disabler_status"
        print_mod "PROC " "$process_obfuscation_status"
        print_mod "PRXY " "$proxychains_integration_status"
        print_mod "TOR  " "$tor_bridges_status"
        print_mod "KILL " "$kill_switch_status"
        print_mod "I2P  " "$i2p_integration_status"
        print_mod "TRAFF" "$traffic_obfuscation_status"
        print_mod "DPI  " "$dpi_spoofing_status"
        print_mod "DOH  " "$doh_shield_status"
        print_mod "JAIL " "$sandbox_isolation_status"
        print_mod "STLTH" "$execution_stealth_status"
        
        if [[ $count -eq 0 ]]; then
            boxline "${DIM}  No modules active${RESET}"
        else
            boxline "  ${mod_line}"
        fi
        
        emptybox
        draw_sep
        emptybox
        boxline "${DIM}  Press ${BOLD}q${RESET}${DIM} to return to menu  ·  Refreshes every 3s${RESET}"
        emptybox
        draw_end
        
        read -t 3 -rsn1 key
        if [[ "$key" == "q" || "$key" == "Q" ]]; then
            kill "$bg_pid" 2>/dev/null || true
            rm -f "$status_file"
            break
        fi
    done
    tput cnorm 2>/dev/null
}


