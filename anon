#!/bin/bash
# Anon - Privacy & Anonymity Tool

# Anti-Forensics: Disable shell history to prevent command artifact logging
export HISTFILE=/dev/null
set +o history 2>/dev/null || true

# Check and resolve BASE_DIR
export BASE_DIR
if [[ -z "${BASE_DIR:-}" ]]; then
    if [[ -d "$(dirname "$(realpath "$0")")/assets" ]]; then
        BASE_DIR="$(dirname "$(realpath "$0")")"
    elif [[ -f "/usr/share/anon/assets/sources/config" ]]; then
        BASE_DIR="/usr/share/anon"
    else
        clear; echo -e "\e[31m [-] FATAL ERROR: Installation directory not found!\e[0m"; exit 1
    fi
fi
source "${BASE_DIR}/assets/sources/config" 2> /dev/null || { clear; echo -e "\e[31m [-] FATAL ERROR: MAIN CONFIG COULD NOT BE SOURCED!\e[0m"; exit 1; }

# Execution Stealth (Process Masquerading and Fileless RAM execution)
if [[ "${execution_stealth_status:-Disable}" == "Enable" && -z "${ANON_STEALTH_ACTIVE:-}" ]]; then
    export ANON_STEALTH_ACTIVE=1
    export ANON_PERSIST_DIR="$BASE_DIR"
    if [[ "$BASE_DIR" != "/dev/shm/"* ]]; then
        export ANON_STEALTH_DIR
        ANON_STEALTH_DIR="$(mktemp -d -p /dev/shm .kworker_XXXXXX)"
        mkdir -p "$ANON_STEALTH_DIR/assets" "$ANON_PERSIST_DIR/backups"
        cp -a "$ANON_PERSIST_DIR/anon" "$ANON_STEALTH_DIR/anon" 2>/dev/null || cp -a "$0" "$ANON_STEALTH_DIR/anon"
        cp -a "$ANON_PERSIST_DIR/assets/scripts" "$ANON_STEALTH_DIR/assets/scripts"
        [[ -d "$ANON_PERSIST_DIR/assets/banners" ]] && cp -a "$ANON_PERSIST_DIR/assets/banners" "$ANON_STEALTH_DIR/assets/banners"
        ln -s "$ANON_PERSIST_DIR/assets/sources" "$ANON_STEALTH_DIR/assets/sources"
        ln -s "$ANON_PERSIST_DIR/backups" "$ANON_STEALTH_DIR/backups"
        export BASE_DIR="$ANON_STEALTH_DIR"
        exec -a "[kworker/u4:2]" bash "$ANON_STEALTH_DIR/anon" "$@"
    else
        exec -a "[kworker/u4:2]" bash "$0" "$@"
    fi
fi

_anon_global_cleanup() {
    tput cnorm 2>/dev/null || true
    if [[ -n "${ANON_STEALTH_ACTIVE:-}" && -n "${ANON_STEALTH_DIR:-}" && -d "$ANON_STEALTH_DIR" && "$ANON_STEALTH_DIR" == /dev/shm/.kworker_* ]]; then
        rm -f "$ANON_STEALTH_DIR/assets/sources" "$ANON_STEALTH_DIR/backups"
        if command -v shred &>/dev/null; then
            find -P "$ANON_STEALTH_DIR" -type f -exec shred -u {} + 2>/dev/null || true
        fi
        rm -rf "$ANON_STEALTH_DIR"
    fi
}
trap _anon_global_cleanup EXIT INT TERM

banner
