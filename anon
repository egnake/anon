# ── Centering helper ──
center() {
    local text="$1"
    local width
    width=$(tput cols 2>/dev/null || echo 80)
    # Strip ANSI codes for length calculation
    local stripped
    stripped=$(echo -e "$text" | sed 's/\x1b\[[0-9;]*m//g')
    local len=${#stripped}
    local pad=$(( (width - len) / 2 ))
    (( pad < 0 )) && pad=0
    printf "%${pad}s" ""
    echo -e "$text"
}

# ── Box drawing ──
draw_line() {
    local width
    width=$(tput cols 2>/dev/null || echo 80)
    local inner=$(( width - 4 ))
    (( inner > 72 )) && inner=72
    local pad=$(( (width - inner - 2) / 2 ))
    (( pad < 0 )) && pad=0
    printf "%${pad}s" ""
    printf "${DIM}"
    printf "╔"
    printf '═%.0s' $(seq 1 $inner)
    printf "╗"
    printf "${RESET}\n"
}

draw_mid() {
    local width
    width=$(tput cols 2>/dev/null || echo 80)
    local inner=$(( width - 4 ))
    (( inner > 72 )) && inner=72
    local pad=$(( (width - inner - 2) / 2 ))
    (( pad < 0 )) && pad=0
    printf "%${pad}s" ""
    printf "${DIM}"
    printf "╠"
    printf '═%.0s' $(seq 1 $inner)
    printf "╣"
    printf "${RESET}\n"
}

draw_end() {
    local width
    width=$(tput cols 2>/dev/null || echo 80)
    local inner=$(( width - 4 ))
    (( inner > 72 )) && inner=72
    local pad=$(( (width - inner - 2) / 2 ))
    (( pad < 0 )) && pad=0
    printf "%${pad}s" ""
    printf "${DIM}"
    printf "╚"
    printf '═%.0s' $(seq 1 $inner)
    printf "╝"
    printf "${RESET}\n"
}

draw_sep() {
    local width
    width=$(tput cols 2>/dev/null || echo 80)
    local inner=$(( width - 4 ))
    (( inner > 72 )) && inner=72
    local pad=$(( (width - inner - 2) / 2 ))
    (( pad < 0 )) && pad=0
    printf "%${pad}s" ""
    printf "${DIM}"
    printf "║"
    printf '─%.0s' $(seq 1 $inner)
    printf "║"
    printf "${RESET}\n"
}

boxline() {
    local text="$1"
    local width
    width=$(tput cols 2>/dev/null || echo 80)
    local inner=$(( width - 4 ))
    (( inner > 72 )) && inner=72
    local pad=$(( (width - inner - 2) / 2 ))
    (( pad < 0 )) && pad=0
    
    local stripped
    stripped=$(echo -e "$text" | sed 's/\x1b\[[0-9;]*m//g')
    local tlen=${#stripped}
    local rpad=$(( inner - tlen - 1 ))
    (( rpad < 0 )) && rpad=0
    
    printf "%${pad}s" ""
    printf "${DIM}║${RESET} "
    echo -ne "$text"
    printf "%${rpad}s" ""
    printf "${DIM}║${RESET}\n"
}

emptybox() {
    local width
    width=$(tput cols 2>/dev/null || echo 80)
    local inner=$(( width - 4 ))
    (( inner > 72 )) && inner=72
    local pad=$(( (width - inner - 2) / 2 ))
    (( pad < 0 )) && pad=0
    printf "%${pad}s" ""
    printf "${DIM}║${RESET}"
    printf "%${inner}s" ""
    printf "${DIM}║${RESET}\n"
}

# ── Arrow-key interactive menu ──
interactive_menu() {
    local title="$1"
    shift
    local opts=("$@")
    local selected=0
    local key

    tput civis 2>/dev/null
    while true; do
        clear
        banner
        draw_line
        emptybox
        boxline "${BOLD}${CYAN}  $title${RESET}"
        emptybox
        draw_sep

        for i in "${!opts[@]}"; do
            if [[ $i -eq $selected ]]; then
                boxline "${BOLD}${GREEN}  ▸ ${opts[$i]}${RESET}"
            else
                boxline "${DIM}    ${opts[$i]}${RESET}"
            fi
        done

        draw_sep
        emptybox
        [[ -n "$stat" ]] && boxline "${YELLOW}  ◆ $stat${RESET}"
        # Show active module count if config is loaded
        if [[ -f "$SRCDIR/sources/config" ]]; then
            local active_count=0
            active_count=$(grep -c 'status="Enable"' "$SRCDIR/sources/config" 2>/dev/null) || true
            if [[ "$active_count" -gt 0 ]] 2>/dev/null; then
                boxline "${GREEN}  ● ${active_count} module(s) active${RESET}"
            fi
        fi
        boxline "${DIM}  ↑↓ Navigate  ⏎ Select  q Quit${RESET}"
        emptybox
        draw_end

        read -rsn1 key
        if [[ "$key" == $'\x1b' ]]; then
            read -rsn2 key
            if [[ "$key" == "[A" ]]; then
                ((selected--))
                (( selected < 0 )) && selected=$((${#opts[@]} - 1))
            elif [[ "$key" == "[B" ]]; then
                ((selected++))
                (( selected >= ${#opts[@]} )) && selected=0
            fi
        elif [[ "$key" == "" ]]; then
            break
        elif [[ "$key" == "q" || "$key" == "Q" ]]; then
            tput cnorm 2>/dev/null
            clear
            exit 0
        fi
    done
    tput cnorm 2>/dev/null
    SELECTED_INDEX=$selected
}

