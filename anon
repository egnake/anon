        print_live_status "Kill-Switch" "$kill_switch_status"
        
        echo -e "\n\n ${DIM}(Press Ctrl+C to exit dashboard)${RESET}"
        sleep 2
    done
}

browser() {
    info "Launching Disposable Browser Session..."
    local ff_cmd=""
    if command -v firefox-esr &> /dev/null; then
        ff_cmd="firefox-esr"
    elif command -v firefox &> /dev/null; then
        ff_cmd="firefox"
    else
        err "Firefox is not installed. Please install it first."
    fi

    local temp_profile=$(mktemp -d /tmp/anon_browser_XXXXXX)
    info "Created temporary profile at $temp_profile"
    
    if [ -f /usr/share/anon/assets/sources/anon.js ]; then
        cp /usr/share/anon/assets/sources/anon.js $temp_profile/user.js
        msg "Anti-fingerprinting rules injected."
    fi

    info "Starting browser in Private Mode. Close the browser to delete session data."
    local run_user="${SUDO_USER:-root}"
    if [ "$run_user" == "root" ]; then
        warn "Running browser as root is not recommended and may fail. Please run via 'sudo anon --browser'."
        $ff_cmd --profile "$temp_profile" --private-window "https://check.torproject.org/" &> /dev/null
    else
        chown -R $run_user:$run_user $temp_profile
        sudo -u $run_user $ff_cmd --profile "$temp_profile" --private-window "https://check.torproject.org/" &> /dev/null
    fi
    
    info "Browser closed. Wiping disposable profile data..."
    if command -v srm &> /dev/null; then
        srm -rf $temp_profile
    else
        rm -rf $temp_profile
    fi
    msg "Disposable session destroyed successfully!"
    exit 0
}

fix(){

