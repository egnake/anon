dashboard() {
    (
        tput civis 2>/dev/null || true

        local status_file
        status_file=$(mktemp -p /dev/shm .anon_net_XXXXXX)
        echo "WAITING" > "$status_file"

        (
            while true; do
                reload_state
                if [[ "${ip_changer_status:-Disable}" == "Enable" ]]; then
                    local tor_check
                    tor_check=$(curl -s --max-time 10 --socks5-hostname 127.0.0.1:9050 https://check.torproject.org/api/ip 2>/dev/null)
                    if echo "$tor_check" | grep -q '"IsTor":true'; then
                        local current_ip
                        current_ip=$(echo "$tor_check" | grep -o '"IP":"[^"]*"' | cut -d'"' -f4)
                        echo "SECURE_TOR|$current_ip" > "$status_file"
                    else
                        echo "SECURE_SLOW|Hidden" > "$status_file"
                    fi
                elif [[ "${i2p_integration_status:-Disable}" == "Enable" ]]; then
                    echo "SECURE_I2P|Hidden" > "$status_file"
                else
                    echo "UNSECURE|Direct (Unprotected)" > "$status_file"
                fi
                sleep 5
            done
        ) &
        local bg_pid=$!

        _cleanup_dash() {
            kill "$bg_pid" 2>/dev/null || true
            wait "$bg_pid" 2>/dev/null || true
            rm -f "$status_file"
            tput cnorm 2>/dev/null || true
        }
        trap _cleanup_dash EXIT INT TERM

        while true; do
            clear
            banner
            draw_line
            emptybox
            boxline "${BOLD}${MAGENTA}  ◈ LIVE DASHBOARD${RESET}"
            emptybox
            draw_sep

            reload_state

            local net_status
            net_status=$(cat "$status_file" 2>/dev/null || echo "WAITING")
            local net_state="${net_status%%|*}"
            local net_ip="${net_status##*|}"

            if [[ "$net_state" == "SECURE_TOR" ]]; then
                boxline "${GREEN}  ● Network    ${BOLD}SECURE${RESET}${GREEN} (Tor Active)${RESET}"
                boxline "${CYAN}  ● Exit IP    ${YELLOW}${net_ip}${RESET}"
            elif [[ "$net_state" == "SECURE_SLOW" ]]; then
                boxline "${YELLOW}  ● Network    ${BOLD}SECURE${RESET}${YELLOW} (Routing / High Latency)${RESET}"
                boxline "${CYAN}  ● Exit IP    ${YELLOW}Hidden (Tor Encrypted)${RESET}"
            elif [[ "$net_state" == "SECURE_I2P" ]]; then
                boxline "${GREEN}  ● Network    ${BOLD}SECURE${RESET}${GREEN} (I2P Router Active)${RESET}"
                boxline "${CYAN}  ● Exit IP    ${YELLOW}Hidden (I2P)${RESET}"
            elif [[ "$net_state" == "WAITING" ]]; then
                boxline "${CYAN}  ● Network    ${BOLD}SCANNING...${RESET}"
                boxline "${CYAN}  ● Exit IP    ${YELLOW}Detecting...${RESET}"
            else
                boxline "${RED}  ○ Network    ${BOLD}UNSECURE${RESET}${RED} (Direct)${RESET}"
                boxline "${CYAN}  ● IP         ${YELLOW}${net_ip}${RESET}"
            fi

            local iface
            iface="$(get_default_iface)"
            if [[ -n "$iface" ]] && [[ -f "/sys/class/net/$iface/statistics/rx_bytes" ]]; then
                local rx tx rx_mb tx_mb
                rx=$(cat "/sys/class/net/$iface/statistics/rx_bytes")
                tx=$(cat "/sys/class/net/$iface/statistics/tx_bytes")
                rx_mb=$(awk "BEGIN {printf \"%.1f\", $rx/1048576}")
                tx_mb=$(awk "BEGIN {printf \"%.1f\", $tx/1048576}")
                boxline "${CYAN}  ● Traffic    ${GREEN}↑${tx_mb}MB ${CYAN}↓${rx_mb}MB${RESET}${DIM} on ${iface}${RESET}"
            fi

            draw_sep
            boxline "${BOLD}${WHITE}  ACTIVE MODULES:${RESET}"
            emptybox

            local mod_line="" count=0 line_items=0 idx mod_var
            for idx in "${!MOD_NAMES[@]}"; do
                mod_var="${MOD_NAMES[$idx]}_status"
                if [[ "${!mod_var:-Disable}" == "Enable" ]]; then
                    mod_line+="${GREEN}■${RESET}${MOD_TAGS[$idx]}  "
                    ((count++))
                    ((line_items++))
                    if [[ $line_items -ge 7 ]]; then
                        boxline "  ${mod_line}"
                        mod_line=""
                        line_items=0
                    fi
                fi
            done

            if [[ $count -eq 0 ]]; then
                boxline "${DIM}  No modules active${RESET}"
            elif [[ -n "$mod_line" ]]; then
                boxline "  ${mod_line}"
            fi

            emptybox
            draw_sep
            emptybox
            boxline "${DIM}  Press ${BOLD}q${RESET}${DIM} to return to menu  ·  Refreshes every 3s${RESET}"
            emptybox
            draw_end

            local key=""
            read -t 3 -rsn1 key || true
            if [[ "$key" == "q" || "$key" == "Q" ]]; then
                break
            fi
        done
    )
}

