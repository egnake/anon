        anti_cold_boot) [[ -f "$BACKUPDIR/min_free_kbytes.bak" ]] ;;
        proxychains_integration) [[ -f "$BACKUPDIR/proxychains4.conf.bak" ]] ;;
        sandbox_isolation) ip netns list 2>/dev/null | grep -qw "anon_jail" ;;
        *) return 1 ;;
    esac
}

_start_module() {
