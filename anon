src_check() {
    local check_status="1"
    local module standalone
    for module in "$@"; do
        if [[ -f "$SRCDIR/scripts/$module" ]]; then
            source "$SRCDIR/scripts/$module"
        else
            warn "The source file could not be found. Please re-install the tool. (Module: $module)"
            check_status="0"
        fi
    done
    for standalone in anti_mitm traffic_obfuscation sandbox_isolation disposable_browser leak_auditor metadata_cleaner; do
        if [[ ! -f "$SRCDIR/scripts/$standalone" ]]; then
            warn "The source file could not be found. Please re-install the tool. (Module: $standalone)"
            check_status="0"
        fi
    done
    if [[ "$check_status" == "0" ]]; then
        err "Please run this command:\n'${GREEN}sudo make reinstall${RESET}'"
    fi
}
