_is_pid_alive() {
    local pid="$1"
    [[ -n "$pid" && "$pid" != "0" && "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

_is_module_live() {
    local mod_name="$1"
    case "$mod_name" in
        anti_mitm) _is_pid_alive "${anti_mitm_pid:-0}" ;;
        leak_auditor) _is_pid_alive "${leak_auditor_pid:-0}" ;;
        traffic_obfuscation) _is_pid_alive "${traffic_obfuscation_pid:-0}" ;;
        ip_changer) [[ -f "$BACKUPDIR/torrc.bak" ]] ;;
        kill_switch) [[ -f "$BACKUPDIR/iptables_killswitch.bak" ]] ;;
        dns_changer) [[ -f "$BACKUPDIR/resolv.dns.bak" || -f "$BACKUPDIR/resolv.conf.bak" ]] ;;
        doh_shield) [[ -f "$BACKUPDIR/resolv.doh.bak" || -f "$BACKUPDIR/resolv.conf.doh.bak" ]] ;;
        mac_changer) [[ -d "$BACKUPDIR/mac_addresses" ]] ;;
        hostname_changer) [[ -f "$BACKUPDIR/hostname.bak" ]] ;;
        timezone_changer) [[ -f "$BACKUPDIR/timezone.bak" ]] ;;
