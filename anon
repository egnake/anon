#!/bin/bash
# Anon - Privacy & Anonymity Tool

#check source files
if [[ -z "${BASE_DIR}" ]]; then
    if [[ -d "$(dirname "$(realpath "$0")")/assets" ]]; then
        export BASE_DIR="$(dirname "$(realpath "$0")")"
    elif [[ -f "/usr/share/anon/assets/sources/config" ]]; then
        export BASE_DIR="/usr/share/anon"
    else
        clear; echo -e "\e[31m [-] FATAL ERROR: Installation directory not found!\e[0m"; exit 1;
    fi
fi
source "${BASE_DIR}/assets/sources/config" 2> /dev/null || { clear;echo -e "\e[31m [-] FATAL ERROR: MAIN CONFIG COULD NOT BE SOURCED!\e[0m";exit 1;}

banner
# run with a root privilege
[[ "$EUID" -ne 0 ]] && err "Anon must be run as root. ${GREEN}'sudo $(basename "${0}")'${RESET}" 

src_check() {

        check_status="1"
        for module in "$@"; do
                if [[ -f "$SRCDIR/scripts/$module" ]]; then
			source "$SRCDIR/scripts/$module" 
		else
			warn "The source file could not be found. Please re-install the tool. (Module: $module)"
			check_status="0"
                fi
        done
        if [ "${check_status}" = "0" ] ; then
                err "Please run this command:\n'${GREEN}sudo make reinstall${RESET}'"
        fi
}
src_check fix kill_switch log_killer ip_changer dns_changer mac_changer anti_cold_boot hostname_changer timezone_changer browser_anonymization os_obfuscation bluetooth_disabler process_obfuscation proxychains_integration tor_bridges i2p_integration

#check dependences function
dep_check() {
    local missing_pkgs=()
    local apt_pkgs=""

    for cmd in "$@"; do
        if ! command -v "$cmd" &> /dev/null; then
            warn "$cmd: could not be found."
            
            # Map commands to actual Debian/Kali package names
            if [ "$cmd" == "scapy" ]; then
                apt_pkgs="$apt_pkgs python3-scapy"
            elif [ "$cmd" == "sdmem" ]; then
                apt_pkgs="$apt_pkgs secure-delete"
            else
                apt_pkgs="$apt_pkgs $cmd"
            fi
            missing_pkgs+=("$cmd")
        fi
    done

    if [ ${#missing_pkgs[@]} -gt 0 ]; then
        echo -ne "
 ${CYAN}ℹ INFO:${RESET} Some required dependencies are missing: ${BOLD}${missing_pkgs[*]}${RESET}
"
        echo -ne " ${YELLOW}➤ Do you want Anon to automatically install them for you? (Y/n): ${RESET}"
        read -r choice
        case "$choice" in 
          y|Y|"" ) 
            echo -e "
 ${CYAN}ℹ INFO:${RESET} Installing missing packages..."
            apt-get update
            apt-get install -y $apt_pkgs
            
            # Re-check after installation
            for cmd in "$@"; do
                if ! command -v "$cmd" &> /dev/null; then
                    err "Failed to install $cmd. Please install it manually."
                fi
            done
            msg "All dependencies installed successfully!
"
            ;;
          * ) 
            err "Dependencies are required to run Anon. Exiting."
            ;;
        esac
    fi
}

start(){

#check dependences
dep_check tar tor curl python3 scapy sdmem obfs4proxy macchanger proxychains4 rfkill i2pd

#get a backup to fix it in case of a possible error 
if [ ! -f $BACKUPDIR/anon_fix_backups.tar.gz ]; then
	get_backups
fi

options=("Anti Mitm" "Log killer" "Ip changer" "Dns changer" "Mac changer" "Timezone changer" "Hostname changer" "Browser anonymization" "OS Obfuscation" "Bluetooth disabler" "Process obfuscation" "Proxychains integration" "Anti cold boot" "Tor bridges" "Kill switch" "I2P Integration")

menu() {
    echo -e " ${BOLD}${CYAN}❖ AVAILABLE SECURITY MODULES ❖${RESET}\n"
    for opt in "${!options[@]}"; do
        if [[ "${choices[opt]}" == "✓" ]]; then
            printf "  ${GREEN} [%s] %-25s ${BOLD}[ ✔ ON ]${RESET}\n" "$((opt+1))" "${options[opt]}"
        else
            printf "  ${DIM} [%s] %-25s [ ✗ OFF]${RESET}\n" "$((opt+1))" "${options[opt]}"
        fi
    done
    echo -e "\n${DIM} ══════════════════════════════════════════════${RESET}"
    echo -e "  ${BOLD}${YELLOW}[0]${RESET} ${CYAN}🚀 APPLY SETTINGS & START${RESET}"
    echo -e "  ${BOLD}${MAGENTA}[p]${RESET} ${DIM}📂 LOAD SECURITY PROFILE${RESET}"
    echo -e "  ${BOLD}${RED}[q]${RESET} ${DIM}❌ EXIT MENU${RESET}"
    echo -e "${DIM} ══════════════════════════════════════════════${RESET}"
    [[ "$stat" ]] && info "$stat"
    return 0
}
 
while banner && menu && input && read -r num; do
    if [[ -z "$num" ]]; then continue; fi
    if [[ "$num" == "0" ]]; then break; fi
    if [[ "$num" == "p" || "$num" == "P" ]]; then
        clear
        echo -e " ${BOLD}${CYAN}❖ SELECT A SECURITY PROFILE ❖${RESET}\n"
        echo -e "  ${BOLD}${RED}[1]${RESET} ${GREEN}Paranoia Mode${RESET} (Max Security: Tor, Bridges, Mac, Log Killer, MITM, Browser, Kill Switch)"
        echo -e "  ${BOLD}${YELLOW}[2]${RESET} ${CYAN}Quick Surf${RESET}  (Fast Anonymity: Tor, DNS, Browser)"
        echo -e "  ${BOLD}${BLUE}[3]${RESET} ${MAGENTA}Pentest Mode${RESET} (Offensive: Proxychains, OS/Process Obfuscation, Mac, MITM)"
        echo -e "  ${BOLD}${CYAN}[4]${RESET} ${BOLD}Darknet Explorer${RESET} (Tor + I2P, Bridges, DNS)"
        echo -e "  ${BOLD}${MAGENTA}[5]${RESET} ${YELLOW}Physical Lockdown${RESET} (Anti-Cold Boot, Bluetooth off, MITM, Kill Switch)"
        echo -e "  ${BOLD}${WHITE}[6]${RESET} ${RED}The Ghost (Ultimate)${RESET} (ALL 16 MODULES ACTIVATED)"
        echo -e "  ${BOLD}${DIM}[b]${RESET} Go Back"
        echo -ne "\n   ${YELLOW}➤ Select a profile: ${RESET}"
        read -r prof
        
        for i in "${!choices[@]}"; do choices[i]=""; done
        case "$prof" in
            1) for i in 0 1 2 3 4 5 6 7 12 13 14; do choices[$i]="✓"; done; stat="Loaded: Paranoia Mode" ;;
            2) for i in 2 3 7; do choices[$i]="✓"; done; stat="Loaded: Quick Surf Mode" ;;
            3) for i in 0 2 4 6 8 10 11; do choices[$i]="✓"; done; stat="Loaded: Pentest Mode" ;;
            4) for i in 2 3 13 15; do choices[$i]="✓"; done; stat="Loaded: Darknet Explorer" ;;
            5) for i in 0 9 12 14; do choices[$i]="✓"; done; stat="Loaded: Physical Lockdown" ;;
            6) for i in {0..15}; do choices[$i]="✓"; done; stat="Loaded: The Ghost (Ultimate)" ;;
            *) stat="Profile selection cancelled." ;;
        esac
        continue
    fi
    if [[ "$num" == "q" || "$num" == "Q" ]]; then
        echo -e "\n\e[32mExiting Anon Setup...\e[0m"
        exit 0
    fi
    if [[ "$num" != *[![:digit:]]* ]] && (( num > 0 && num <= ${#options[@]} )); then
        ((num--)); stat="${options[num]} was ${choices[num]:+un}checked"
        [[ "${choices[num]}" ]] && choices[num]="" || choices[num]="✓"
    else
        stat="Invalid option: $num"
    fi
done
banner
#detect selected features and run
# Run tor_bridges first if selected so that ip_changer can use it
if [[ "${choices[13]}" ]]; then
	$(echo start_${options[13]} | sed -e 's/ /_/g;s/\(.*\)/\L\1/;s/ı/i/g')
	choices[13]=""
fi

# Run mac_changer BEFORE anti_mitm. 
# mac_changer brings the network interface down/up which crashes scapy (anti_mitm) if run after it.
if [[ "${choices[4]}" ]]; then
	$(echo start_${options[4]} | sed -e 's/ /_/g;s/\(.*\)/\L\1/;s/ı/i/g')
	choices[4]=""
fi

for opt in "${!options[@]}"; do

	start_anti_mitm(){
	python3 "${BASE_DIR}/assets/scripts/anti_mitm" &
	antimitmpid="$!"
	sed -i 's/anti_mitm_pid="0"/anti_mitm_pid="'$antimitmpid'"/g;s/anti_mitm_status="Disable"/anti_mitm_status="Enable"/g' $SRCDIR/sources/config
	info "Anti mitm successfully enabled"
	}

	for st in "${!options[@]}"; do
	  if [[ -n "${choices[opt]}" ]] && [[ "${options[opt]}" == "${options[st]}" ]]; then
		 $(echo "start_${options[st]}" | sed -e 's/ /_/g;s/\(.*\)/\L\1/;s/ı/i/g')
	  fi
	done

done

}

stop(){

#detect enable features and stop
if grep -q "Enable" "$SRCDIR/sources/config" 2>/dev/null; then

	options=("anti_mitm" "ip_changer" "dns_changer" "mac_changer" "timezone_changer" "hostname_changer" "browser_anonymization" "os_obfuscation" "bluetooth_disabler" "process_obfuscation" "proxychains_integration" "tor_bridges" "anti_cold_boot" "i2p_integration")

	stop_anti_mitm(){

	       [[ -n "$anti_mitm_pid" && "$anti_mitm_pid" != "0" ]] && kill "$anti_mitm_pid" 2>/dev/null
	       sed -i 's/anti_mitm_pid="'$anti_mitm_pid'"/anti_mitm_pid="0"/g;s/anti_mitm_status="Enable"/anti_mitm_status="Disable"/g' $SRCDIR/sources/config
	       info "Anti mitm successfully disabled"
	}

	for st in "${!options[@]}"; do
	  status="${options[st]}_status"
	  if [[ "${!status}" == "Enable" ]]; then
		"stop_${options[st]}"
	  fi
	done

else
	err "No features are active. (Run to activate '${GREEN}sudo anon --start${RESET}')"
fi
}

status(){

echo -e " ${BOLD}${MAGENTA}ANON SYSTEM STATUS${RESET}"
echo -e " ${DIM}─────────────────────────────────────────────────────────${RESET}"

print_status() {
    local mod_name="$1"
    local mod_status="$2"
