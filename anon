            source "$SRCDIR/sources/config"
            if [[ "$ip_changer_status" == "Enable" ]]; then
                local tor_check
                tor_check=$(curl -s --max-time 10 --socks5-hostname 127.0.0.1:9050 https://check.torproject.org/api/ip 2>/dev/null)
                if echo "$tor_check" | grep -q '"IsTor":true'; then
                    local current_ip
                    current_ip=$(echo "$tor_check" | grep -o '"IP":"[^"]*"' | cut -d'"' -f4)
                    echo "SECURE_TOR|$current_ip" > "$status_file"
