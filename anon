            _render_cat "${BOLD}${BLUE}  ── Network & Routing ──${RESET}" "${NET_CAT_INDICES[@]}"
            emptybox
            _render_cat "${BOLD}${MAGENTA}  ── System Obfuscation ──${RESET}" "${OBF_CAT_INDICES[@]}"
            emptybox
            _render_cat "${BOLD}${RED}  ── Active Defense ──${RESET}" "${DEF_CAT_INDICES[@]}"

            emptybox
            if [[ $cursor -eq $total_items ]]; then
                boxline "${BOLD}${YELLOW}  ▸ ◀ BACK TO MAIN MENU${RESET}"
            else
                boxline "${DIM}    ◀ BACK TO MAIN MENU${RESET}"
            fi

            draw_sep
            emptybox
            boxline "${DIM}  ↑↓/jk Navigate  ⏎/Space Toggle  a All/None  q Quit${RESET}"
            emptybox
            draw_end

            action=$(_read_nav_key) || continue
            case "$action" in
                UP)
                    ((cursor--))
                    (( cursor < 0 )) && cursor=$total_items
                    ;;
                DOWN)
                    ((cursor++))
                    (( cursor > total_items )) && cursor=0
                    ;;
                SELECT)
                    if [[ $cursor -eq $total_items ]]; then
                        break
                    else
                        local mod_i=${visual_order[$cursor]}
                        if [[ "${choices[$mod_i]:-}" == "✓" ]]; then
                            choices[$mod_i]=""
                        else
                            choices[$mod_i]="✓"
                        fi
                    fi
                    ;;
                ALL)
                    local any_unchecked=0 idx_chk
                    for idx_chk in "${visual_order[@]}"; do
                        if [[ "${choices[$idx_chk]:-}" != "✓" ]]; then
                            any_unchecked=1
                            break
                        fi
                    done
                    for idx_chk in "${visual_order[@]}"; do
                        if [[ $any_unchecked -eq 1 ]]; then
                            choices[$idx_chk]="✓"
                        else
                            choices[$idx_chk]=""
                        fi
                    done
                    ;;
                ESC)
                    break
                    ;;
                QUIT)
                    tput cnorm 2>/dev/null || true
                    clear
                    exit 0
                    ;;
            esac
        done
        tput cnorm 2>/dev/null || true
