#!/bin/bash

# colors
RESET="\e[0m"
BOLD="\e[1m"
DIM="\e[2m"
RED="\e[31m"
GREEN="\e[32m"
YELLOW="\e[33m"
BLUE="\e[34m"
MAGENTA="\e[35m"
CYAN="\e[36m"
WHITE="\e[37m"
BG_BLUE="\e[44m"

# backup and source directories
if [[ -z "${BASE_DIR:-}" ]]; then
    _cfg_root="$(dirname "$(dirname "$(dirname "$(realpath "${BASH_SOURCE[0]}")")")")"
    if [[ -f "${_cfg_root}/assets/sources/config" ]]; then
        BASE_DIR="$_cfg_root"
    elif [[ -f "/usr/share/anon/assets/sources/config" ]]; then
        BASE_DIR="/usr/share/anon"
    else
        BASE_DIR="$_cfg_root"
    fi
    unset _cfg_root
    export BASE_DIR
fi
BACKUPDIR="${BACKUPDIR:-${ANON_PERSIST_DIR:-${BASE_DIR}}/backups}"
mkdir -p "$BACKUPDIR" 2>/dev/null || true
SRCDIR="${BASE_DIR}/assets"
ANON_STATE_FILE="${ANON_STATE_FILE:-${BACKUPDIR}/anon.state}"
export BACKUPDIR SRCDIR ANON_STATE_FILE

# tor config file
TORRC="${TORRC:-/etc/tor/torrc}"
tor_uid="$(id -u debian-tor 2>/dev/null || id -u tor 2>/dev/null || id -u _tor 2>/dev/null || echo "109")"

# Default module states (overridden by $ANON_STATE_FILE)
anti_mitm_status="Disable"
ip_changer_status="Disable"
dns_changer_status="Disable"
mac_changer_status="Disable"
timezone_changer_status="Disable"
hostname_changer_status="Disable"
browser_anonymization_status="Disable"
kill_switch_status="Disable"
tor_bridges_status="Disable"
os_obfuscation_status="Disable"
bluetooth_disabler_status="Disable"
process_obfuscation_status="Disable"
proxychains_integration_status="Disable"
anti_cold_boot_status="Disable"
i2p_integration_status="Disable"
traffic_obfuscation_status="Disable"
sandbox_isolation_status="Disable"
volatile_logging_status="Disable"
dpi_spoofing_status="Disable"
doh_shield_status="Disable"
execution_stealth_status="Disable"
leak_auditor_status="Disable"
anti_mitm_pid="0"
traffic_obfuscation_pid="0"
leak_auditor_pid="0"

# Load shared helper functions and runtime state overrides
if [[ -f "${SRCDIR}/sources/helpers" ]]; then
    # shellcheck disable=SC1091
    source "${SRCDIR}/sources/helpers"
fi
if [[ -f "${ANON_STATE_FILE}" ]]; then
    # shellcheck disable=SC1090
    source "${ANON_STATE_FILE}" 2>/dev/null || true
fi

# UI Functions
err() {
    echo -e "\n ${BG_BLUE}${WHITE}${BOLD} ANON ${RESET} ${RED}✖ ERROR:${RESET} $*\n"
    exit 1
}

warn() {
    echo -e " ${YELLOW}⚠ WARNING:${RESET} $*"
}

msg() {
    echo -e " ${GREEN}✔ SUCCESS:${RESET} $*"
}

info() {
    echo -e " ${CYAN}ℹ INFO:${RESET} $*"
}

notify() {
    local title="$1"
    local message="$2"
    local urgency="${3:-normal}" # low, normal, critical

    if command -v notify-send &>/dev/null; then
        local user_disp="${DISPLAY:-:0}"
        local active_user="${SUDO_USER:-root}"
        local active_home
        active_home=$(getent passwd "$active_user" 2>/dev/null | cut -d: -f6 || true)
        [[ -z "$active_home" ]] && active_home=$([[ "$active_user" == "root" ]] && echo "/root" || echo "/home/$active_user")
        local user_xauth="${XAUTHORITY:-${active_home}/.Xauthority}"

        if [[ -n "$user_disp" ]]; then
            if [[ -n "${SUDO_USER:-}" && "$SUDO_USER" != "root" ]]; then
                sudo -u "$SUDO_USER" DISPLAY="$user_disp" XAUTHORITY="$user_xauth" \
                    notify-send -u "$urgency" -a "ANON" "$title" "$message" 2>/dev/null || true
            else
                DISPLAY="$user_disp" XAUTHORITY="$user_xauth" \
                    notify-send -u "$urgency" -a "ANON" "$title" "$message" 2>/dev/null || true
            fi
        fi
    fi
}

# Initialize random banner once per session so it doesn't change on every menu redraw
if [[ -z "${ANON_CURRENT_BANNER:-}" && -d "$SRCDIR/banners" ]]; then
    banners=("$SRCDIR/banners/"*.txt)
    if [[ ${#banners[@]} -gt 0 && -f "${banners[0]}" ]]; then
        rand_index=$(( RANDOM % ${#banners[@]} ))
        ANON_CURRENT_BANNER="${banners[$rand_index]}"
    fi
fi

banner() {
    clear
    local width
    width=$(tput cols 2>/dev/null || echo 80)
    local bar_len=56
    (( bar_len > width - 2 )) && bar_len=$(( width - 2 ))
    (( bar_len < 10 )) && bar_len=10
    local bar_pad=$(( (width - bar_len) / 2 ))
    (( bar_pad < 0 )) && bar_pad=0

    echo ""
    echo -e "${BOLD}${CYAN}"

    if [[ -n "${ANON_CURRENT_BANNER:-}" && -f "$ANON_CURRENT_BANNER" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line%$'\r'}"
            local stripped_line
            stripped_line=$(printf '%s' "$line" | sed 's/\x1b\[[0-9;]*m//g')
            local line_len=${#stripped_line}
            local line_pad=$(( (width - line_len) / 2 ))
            (( line_pad < 0 )) && line_pad=0
            printf "%${line_pad}s%s\n" "" "$line"
        done < "$ANON_CURRENT_BANNER"
    fi
    echo -e "${RESET}"

    printf "${DIM}%${bar_pad}s" ""
    printf '═%.0s' $(seq 1 "$bar_len")
    printf "${RESET}\n"

    local sub="Advanced OPSEC & Anonymity Framework"
    local ver="v3.0"
    local sub_stripped="${sub}  ${ver}"
    local sub_pad=$(( (width - ${#sub_stripped}) / 2 ))
    (( sub_pad < 0 )) && sub_pad=0
    printf "%${sub_pad}s" ""
    echo -e "${BOLD}${CYAN}${sub}  ${DIM}${ver}${RESET}"

    local contact="github.com/egnake | egcaem000@gmail.com | Report Issue"
    local contact_pad=$(( (width - ${#contact}) / 2 ))
    (( contact_pad < 0 )) && contact_pad=0
    printf "%${contact_pad}s" ""
    echo -e "${DIM}${contact}${RESET}"

    printf "${DIM}%${bar_pad}s" ""
    printf '═%.0s' $(seq 1 "$bar_len")
    printf "${RESET}\n\n"
}
