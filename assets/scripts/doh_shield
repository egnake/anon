#!/bin/bash

# ═══════════════════════════════════════════════════════════════════
# DNS-over-HTTPS (DoH) Shield Module
# Enforces DNSCrypt-Proxy usage for encrypted system DNS resolution
# ═══════════════════════════════════════════════════════════════════

start_doh_shield() {
    source "${BASE_DIR}/assets/sources/config"

    if [[ "${ip_changer_status:-Disable}" == "Enable" ]]; then
        warn "DoH Shield is not available while Ip changer is active."
        return 0
    fi
    if [[ "${dns_changer_status:-Disable}" == "Enable" ]]; then
        warn "DoH Shield is not available while Dns changer is active."
        return 0
    fi

    if [[ "${doh_shield_status:-Disable}" == "Enable" ]]; then
        warn "DoH Shield is already running."
        return 0
    fi

    info "Starting DNS-over-HTTPS (DoH) Shield..."

    if ! command -v dnscrypt-proxy &> /dev/null; then
        info "Installing dnscrypt-proxy..."
        if command -v apt-get &>/dev/null; then
            apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y dnscrypt-proxy || {
                warn "Failed to install dnscrypt-proxy. Please install it manually."
                return 1
            }
        else
            warn "dnscrypt-proxy is missing and apt-get is unavailable."
            return 1
        fi
    fi

    service_ctrl unmask dnscrypt-proxy || true
    if ! service_ctrl start dnscrypt-proxy; then
        warn "Failed to start dnscrypt-proxy daemon. Check /etc/dnscrypt-proxy/dnscrypt-proxy.toml."
        return 1
    fi

    # Wait briefly and verify daemon stays active before overriding /etc/resolv.conf
    sleep 1
    if ! service_ctrl is-active dnscrypt-proxy; then
        warn "dnscrypt-proxy is not active after startup; aborting resolv.conf override to prevent DNS outage."
        return 1
    fi

    backup_resolv_conf "doh"
    lock_nm_dns

    # dnscrypt-proxy default local resolver endpoints
    cat > /etc/resolv.conf <<EOF
# DoH Shield (DNSCrypt) managed by Anon
nameserver 127.0.2.1
nameserver 127.0.0.1
options edns0
EOF
    chattr +i /etc/resolv.conf 2>/dev/null || true

    # Drop direct unencrypted IPv6 DNS requests
    if command -v ip6tables &>/dev/null; then
        ip6tables -C OUTPUT -p udp --dport 53 -j DROP 2>/dev/null \
            || ip6tables -I OUTPUT 1 -p udp --dport 53 -j DROP 2>/dev/null || true
        ip6tables -C OUTPUT -p tcp --dport 53 -j DROP 2>/dev/null \
            || ip6tables -I OUTPUT 1 -p tcp --dport 53 -j DROP 2>/dev/null || true
    fi

    set_module_status "doh_shield" "Enable"
    msg "DNS-over-HTTPS (DoH) Shield activated."
}

stop_doh_shield() {
    source "${BASE_DIR}/assets/sources/config"
    info "Stopping DNS-over-HTTPS (DoH) Shield..."
    service_ctrl stop dnscrypt-proxy || true

    if command -v ip6tables &>/dev/null; then
        ip6tables -D OUTPUT -p udp --dport 53 -j DROP 2>/dev/null || true
        ip6tables -D OUTPUT -p tcp --dport 53 -j DROP 2>/dev/null || true
    fi

    unlock_nm_dns
    restore_resolv_conf "doh"

    set_module_status "doh_shield" "Disable"
    msg "DoH Shield deactivated."
}
