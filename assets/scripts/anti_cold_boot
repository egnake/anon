#!/bin/bash

# ═══════════════════════════════════════════════════════════════════
# Anti Cold Boot — RAM & Swap Secure Wipe
# ═══════════════════════════════════════════════════════════════════

start_anti_cold_boot(){
	source "${BASE_DIR}/assets/sources/config"
	if [[ "$anti_cold_boot_status" == "Disable" ]]; then
		info "Initiating anti cold-boot sequence..."
		
		swapoff -a 
		# Wipe swap partitions if sswap is available
		if command -v sswap &> /dev/null; then
			local swaps
			swaps=$(awk 'NR>1{print $1}' /proc/swaps)
			for swap in $swaps; do
				sswap "$swap" &>/dev/null
			done
		fi
		swapon -a 
		
		# Backup original memory limits to avoid permanently crashing the OS
		cat /proc/sys/vm/min_free_kbytes > "$BACKUPDIR/min_free_kbytes.bak" 2>/dev/null
		cat /proc/sys/vm/oom_kill_allocating_task > "$BACKUPDIR/oom_kill_allocating_task.bak" 2>/dev/null
		cat /proc/sys/vm/overcommit_memory > "$BACKUPDIR/overcommit_memory.bak" 2>/dev/null
		cat /proc/sys/vm/oom_dump_tasks > "$BACKUPDIR/oom_dump_tasks.bak" 2>/dev/null

		sysctl -w vm.min_free_kbytes=1024 &>/dev/null
		sysctl -w vm.drop_caches=3 &>/dev/null
		sysctl -w vm.oom_kill_allocating_task=1 &>/dev/null
		sysctl -w vm.overcommit_memory=1 &>/dev/null
		sysctl -w vm.oom_dump_tasks=0 &>/dev/null
		
		# Secure memory wipe (RAM)
		if grep -qi microsoft /proc/version; then
			warn "WSL environment detected! Skipping RAM/Swap wipe to prevent fatal E_UNEXPECTED host crash."
		else
			if command -v sdmem &> /dev/null; then
				info "Wiping free RAM securely (this may take a moment)..."
				sdmem -f -ll &>/dev/null
			else
				warn "sdmem not found! Skipping RAM wipe. Consider installing secure-delete."
			fi
		fi
		
		sed -i 's/anti_cold_boot_status="Disable"/anti_cold_boot_status="Enable"/g' "$SRCDIR/sources/config"
		info "Anti cold boot successfully enabled"
	else
		warn "Anti cold boot is already running"
	fi
}

stop_anti_cold_boot(){
	source "${BASE_DIR}/assets/sources/config"
	local orig_min_free orig_oom_kill orig_overcommit orig_oom_dump
	orig_min_free=$(cat "$BACKUPDIR/min_free_kbytes.bak" 2>/dev/null || echo "67584")
	orig_oom_kill=$(cat "$BACKUPDIR/oom_kill_allocating_task.bak" 2>/dev/null || echo "0")
	orig_overcommit=$(cat "$BACKUPDIR/overcommit_memory.bak" 2>/dev/null || echo "0")
	orig_oom_dump=$(cat "$BACKUPDIR/oom_dump_tasks.bak" 2>/dev/null || echo "1")

	sysctl -w vm.min_free_kbytes="$orig_min_free" &>/dev/null
	sysctl -w vm.oom_kill_allocating_task="$orig_oom_kill" &>/dev/null
	sysctl -w vm.overcommit_memory="$orig_overcommit" &>/dev/null
	sysctl -w vm.oom_dump_tasks="$orig_oom_dump" &>/dev/null
	
	rm -f "$BACKUPDIR/min_free_kbytes.bak" "$BACKUPDIR/oom_kill_allocating_task.bak" "$BACKUPDIR/overcommit_memory.bak" "$BACKUPDIR/oom_dump_tasks.bak"
	
	sed -i 's/anti_cold_boot_status="Enable"/anti_cold_boot_status="Disable"/g' "$SRCDIR/sources/config"
	info "Anti cold boot successfully disabled"
}