#!/bin/bash

# ═══════════════════════════════════════════════════════════════════
# Volatile Logging — Tails OS Paradigm
# ═══════════════════════════════════════════════════════════════════

start_volatile_logging(){
    source "${BASE_DIR}/assets/sources/config"

    if [[ "${volatile_logging_status:-Disable}" == "Enable" ]]; then
        warn "Volatile logging is already active"
        return 0
    fi

    local log_size="${ANON_VOLATILE_LOG_SIZE:-100M}"
    info "Initializing volatile logging (Tails OS paradigm, size: ${log_size})..."

    if mountpoint -q /var/log 2>/dev/null; then
        warn "/var/log is already a mountpoint; skipping tmpfs overlay"
    else
        mount -t tmpfs -o "size=${log_size},mode=0755" tmpfs /var/log || {
            warn "Failed to mount tmpfs on /var/log"
            return 1
        }
        info "Mounted tmpfs (${log_size}) over /var/log"
    fi

    mkdir -p /var/log/{tor,i2pd,dnscrypt-proxy,apt,cups,samba,journal,private} 2>/dev/null || true
    chmod 0700 /var/log/private 2>/dev/null || true

    # Restore expected ownership so daemons can write logs immediately into tmpfs
    local tor_user i2p_user doh_user
    tor_user="$(id -un debian-tor 2>/dev/null || id -un _tor 2>/dev/null || true)"
    [[ -n "$tor_user" ]] && chown "${tor_user}:adm" /var/log/tor 2>/dev/null || true
    i2p_user="$(id -un _i2pd 2>/dev/null || id -un i2pd 2>/dev/null || true)"
    [[ -n "$i2p_user" ]] && chown "${i2p_user}:${i2p_user}" /var/log/i2pd 2>/dev/null || true
    doh_user="$(id -un _dnscrypt-proxy 2>/dev/null || id -un dnscrypt-proxy 2>/dev/null || true)"
    [[ -n "$doh_user" ]] && chown "${doh_user}" /var/log/dnscrypt-proxy 2>/dev/null || true

    service_ctrl restart systemd-journald || true
    service_ctrl is-active tor.service && service_ctrl restart tor.service || true
    service_ctrl is-active i2pd && service_ctrl restart i2pd || true
    if pidof rsyslogd &>/dev/null; then
        kill -HUP "$(pidof rsyslogd)" 2>/dev/null || true
        info "Sent SIGHUP to rsyslog → writing to RAM"
    fi

    set_module_status "volatile_logging" "Enable"
    info "Volatile logging enabled — all logs now write to volatile RAM"
}

stop_volatile_logging(){
    source "${BASE_DIR}/assets/sources/config"

    info "Restoring persistent logging..."

    if mountpoint -q /var/log 2>/dev/null; then
        sync 2>/dev/null || true
        umount -l /var/log 2>/dev/null || umount /var/log 2>/dev/null || {
            warn "Could not unmount /var/log — it may still be in use"
        }
        info "Unmounted tmpfs from /var/log — historical logs restored"
    else
        info "/var/log is not a tmpfs mountpoint; nothing to unmount"
    fi

    service_ctrl restart systemd-journald || true
    service_ctrl restart rsyslog || true
    service_ctrl is-active tor.service && service_ctrl restart tor.service || true
    service_ctrl is-active i2pd && service_ctrl restart i2pd || true

    set_module_status "volatile_logging" "Disable"
    info "Volatile logging disabled"
}
