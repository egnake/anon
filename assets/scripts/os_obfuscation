#!/bin/bash

# ═══════════════════════════════════════════════════════════════════
# OS Obfuscation — Endpoint Fingerprint Masking
# ═══════════════════════════════════════════════════════════════════

start_os_obfuscation(){
    source "${BASE_DIR}/assets/sources/config"

    if [[ "${os_obfuscation_status:-Disable}" == "Enable" ]]; then
        warn "OS Obfuscation is already running"
        return 0
    fi

    sysctl -n net.ipv4.ip_default_ttl > "$BACKUPDIR/ip_default_ttl.bak" 2>/dev/null || true
    sysctl -n net.ipv4.tcp_timestamps > "$BACKUPDIR/tcp_timestamps.bak" 2>/dev/null || true
    sysctl -n net.ipv4.ip_local_port_range > "$BACKUPDIR/ip_local_port_range.bak" 2>/dev/null || true
    sysctl -n net.ipv4.tcp_window_scaling > "$BACKUPDIR/tcp_window_scaling.bak" 2>/dev/null || true
    sysctl -n net.ipv4.icmp_echo_ignore_broadcasts > "$BACKUPDIR/icmp_echo_ignore_broadcasts.bak" 2>/dev/null || true
    sysctl -n net.ipv4.tcp_sack > "$BACKUPDIR/tcp_sack.bak" 2>/dev/null || true

    sysctl -w net.ipv4.ip_default_ttl=128 &> /dev/null || true
    iptables -t mangle -C POSTROUTING -j TTL --ttl-set 128 2>/dev/null \
        || iptables -t mangle -A POSTROUTING -j TTL --ttl-set 128 2>/dev/null || true

    sysctl -w net.ipv4.tcp_timestamps=0 &> /dev/null || true
    sysctl -w net.ipv4.ip_local_port_range="49152 65535" &> /dev/null || true
    sysctl -w net.ipv4.tcp_window_scaling=0 &> /dev/null || true
    sysctl -w net.ipv4.icmp_echo_ignore_broadcasts=1 &> /dev/null || true
    sysctl -w net.ipv4.tcp_sack=0 &> /dev/null || true

    iptables -t mangle -C POSTROUTING -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss 1460 2>/dev/null \
        || iptables -t mangle -A POSTROUTING -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss 1460 2>/dev/null || true

    set_module_status "os_obfuscation" "Enable"
    info "OS Obfuscation enabled (Windows 10/11 fingerprint emulation)"
}

stop_os_obfuscation(){
    source "${BASE_DIR}/assets/sources/config"

    local orig_ttl orig_ts orig_pr orig_ws orig_ib orig_sack
    orig_ttl=$(cat "$BACKUPDIR/ip_default_ttl.bak" 2>/dev/null || echo "64")
    orig_ts=$(cat "$BACKUPDIR/tcp_timestamps.bak" 2>/dev/null || echo "1")
    orig_pr=$(cat "$BACKUPDIR/ip_local_port_range.bak" 2>/dev/null || echo "32768 60999")
    orig_ws=$(cat "$BACKUPDIR/tcp_window_scaling.bak" 2>/dev/null || echo "1")
    orig_ib=$(cat "$BACKUPDIR/icmp_echo_ignore_broadcasts.bak" 2>/dev/null || echo "1")
    orig_sack=$(cat "$BACKUPDIR/tcp_sack.bak" 2>/dev/null || echo "1")

    sysctl -w net.ipv4.ip_default_ttl="$orig_ttl" &> /dev/null || true
    sysctl -w net.ipv4.tcp_timestamps="$orig_ts" &> /dev/null || true
    sysctl -w net.ipv4.ip_local_port_range="$orig_pr" &> /dev/null || true
    sysctl -w net.ipv4.tcp_window_scaling="$orig_ws" &> /dev/null || true
    sysctl -w net.ipv4.icmp_echo_ignore_broadcasts="$orig_ib" &> /dev/null || true
    sysctl -w net.ipv4.tcp_sack="$orig_sack" &> /dev/null || true

    iptables -t mangle -D POSTROUTING -j TTL --ttl-set 128 2>/dev/null || true
    iptables -t mangle -D POSTROUTING -p tcp --tcp-flags SYN,RST SYN \
        -j TCPMSS --set-mss 1460 2>/dev/null || true

    rm -f "$BACKUPDIR/ip_default_ttl.bak" \
          "$BACKUPDIR/tcp_timestamps.bak" \
          "$BACKUPDIR/ip_local_port_range.bak" \
          "$BACKUPDIR/tcp_window_scaling.bak" \
          "$BACKUPDIR/icmp_echo_ignore_broadcasts.bak" \
          "$BACKUPDIR/tcp_sack.bak"

    set_module_status "os_obfuscation" "Disable"
    info "OS Obfuscation disabled — original TCP/IP fingerprint restored"
}
