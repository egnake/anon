#!/bin/bash

start_log_killer(){
	source /usr/share/anon/assets/sources/config
	info "Starting advanced log destruction..."
	
	log_list=( "/var/log/messages" "/var/log/auth.log" "/var/log/kern.log" "/var/log/cron.log" "/var/log/maillog" "/var/log/boot.log" "/var/log/mysqld.log" "/var/log/secure" "/var/log/utmp" "/var/log/wtmp" "/var/log/yum.log" "/var/log/system.log" "/var/log/DiagnosticMessages" )

	# Traditional logs
	for log in ${log_list[@]}; do
		if [ -f "$log" ];then
			shred -vfzu $log && :> $log
		fi
	done &>/dev/null
	
	# Systemd journal
	if command -v journalctl &> /dev/null; then
		journalctl --vacuum-time=1s &>/dev/null
	fi
	rm -rf /var/log/journal/* &>/dev/null
	
	# User histories and caches
	for user_home in /home/* /root; do
		if [ -d "$user_home" ]; then
			shred -vfzu "$user_home/.bash_history" &>/dev/null
			shred -vfzu "$user_home/.zsh_history" &>/dev/null
			rm -rf "$user_home/.cache/*" &>/dev/null
			rm -rf "$user_home/.local/share/Trash/*" &>/dev/null
		fi
	done
	
	# Temp dirs
	rm -rf /tmp/* /var/tmp/* &>/dev/null

	info "Log killer successfully completed destruction."
}
