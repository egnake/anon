#!/bin/bash

# ═══════════════════════════════════════════════════════════════════
# Proxychains Integration — Tor SOCKS5 Configuration
# ═══════════════════════════════════════════════════════════════════

start_proxychains_integration(){
    source "${BASE_DIR}/assets/sources/config"
    local pc_conf="${ANON_PROXYCHAINS_CONF:-/etc/proxychains4.conf}"
    if [[ "${proxychains_integration_status:-Disable}" == "Disable" ]]; then
        if [[ -f "$pc_conf" ]]; then
            cp "$pc_conf" "$BACKUPDIR/proxychains4.conf.bak"
            sed -i -E 's/^(socks4|socks5)[[:space:]]+.*/socks5  127.0.0.1 9050/' "$pc_conf"
            sed -i 's/^#quiet_mode/quiet_mode/' "$pc_conf"
            set_module_status "proxychains_integration" "Enable"
            info "Proxychains-ng successfully integrated with Tor Socks5"
        else
            warn "proxychains4.conf not found. Is proxychains4 installed?"
        fi
    else
        warn "Proxychains integration is already running"
    fi
}

stop_proxychains_integration(){
    source "${BASE_DIR}/assets/sources/config"
    local pc_conf="${ANON_PROXYCHAINS_CONF:-/etc/proxychains4.conf}"
    if [[ -f "$BACKUPDIR/proxychains4.conf.bak" && -f "$pc_conf" ]]; then
        cat "$BACKUPDIR/proxychains4.conf.bak" > "$pc_conf"
        rm -f "$BACKUPDIR/proxychains4.conf.bak"
    fi
    set_module_status "proxychains_integration" "Disable"
    info "Proxychains-ng integration successfully disabled"
}
