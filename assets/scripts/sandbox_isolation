#!/bin/bash

# ═══════════════════════════════════════════════════════════════════
# Sandbox Isolation — Kernel Namespace + MAC Enforcement
# ═══════════════════════════════════════════════════════════════════
# Never enable set -e at top level because test suites and helpers
# may source this file directly.

if [[ -z "${BASE_DIR:-}" ]]; then
    _si_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [[ -f "${_si_dir}/../sources/config" ]]; then
        BASE_DIR="$(cd "${_si_dir}/../.." && pwd)"
    elif [[ -f "/usr/share/anon/assets/sources/config" ]]; then
        BASE_DIR="/usr/share/anon"
    else
        BASE_DIR="$(cd "${_si_dir}/../.." && pwd)"
    fi
    unset _si_dir
    export BASE_DIR
fi
source "${BASE_DIR}/assets/sources/config"

APPARMOR_TOR_PROFILE="${APPARMOR_TOR_PROFILE:-/etc/apparmor.d/usr.bin.tor.anon}"
NETNS_ETC_DIR="${NETNS_ETC_DIR:-/etc/netns/anon_jail}"

_install_apparmor_profile() {
    if ! command -v apparmor_parser &>/dev/null; then
        info "AppArmor not available — skipping MAC profile installation"
        return 0
    fi

    mkdir -p "$(dirname "$APPARMOR_TOR_PROFILE")" 2>/dev/null || true
    cat > "$APPARMOR_TOR_PROFILE" << 'AAPROFILE'
# AppArmor profile for Tor — ANON Framework
# Restricts Tor (and pluggable transports) to only required resources

#include <tunables/global>

/usr/bin/tor {
    #include <abstractions/base>
    #include <abstractions/nameservice>
    #include <abstractions/openssl>

    capability net_bind_service,
    capability setuid,
    capability setgid,
    capability dac_override,
    capability chown,

    # Tor binary & pluggable transports
    /usr/bin/tor                  mr,
    /usr/sbin/tor                 mr,
    /usr/bin/obfs4proxy           ix,
    /usr/bin/snowflake-client     ix,

    # Configuration, entropy & runtime
    /etc/tor/**                   r,
    /usr/share/tor/**             r,
    /dev/urandom                  r,
    /var/lib/tor/**               rw,
    /var/lib/tor/                 rw,
    /var/log/tor/**               rw,
    /var/log/tor/                 rw,
    /run/tor/**                   rw,
    /run/tor/                     rw,

    # Network access
    network inet stream,
    network inet dgram,
    network inet6 stream,
    network inet6 dgram,
}
AAPROFILE

    apparmor_parser -r "$APPARMOR_TOR_PROFILE" 2>/dev/null && \
        info "AppArmor profile loaded for /usr/bin/tor" || \
        warn "Failed to load AppArmor profile for Tor"
}

_remove_apparmor_profile() {
    if [[ -f "$APPARMOR_TOR_PROFILE" ]]; then
        apparmor_parser -R "$APPARMOR_TOR_PROFILE" 2>/dev/null || true
        rm -f "$APPARMOR_TOR_PROFILE"
        info "AppArmor profile for Tor removed"
    fi
}

_apply_firejail_wrappers() {
    if ! command -v firejail &>/dev/null; then
        info "Firejail not available — skipping sandboxed tool wrappers"
        return 0
    fi

    local -a tools=("curl" "wget" "nmap")
    local wrapper_dir="${WRAPPER_DIR:-/usr/local/bin}"
    mkdir -p "$wrapper_dir" 2>/dev/null || true

    local tool real_path
    for tool in "${tools[@]}"; do
        real_path=$(command -v "$tool" 2>/dev/null || true)
        if [[ -z "$real_path" ]] || grep -q "firejail" "$real_path" 2>/dev/null; then
            continue
        fi
        if [[ "$real_path" == "${wrapper_dir}"/* ]]; then
            continue
        fi

        cat > "${wrapper_dir}/${tool}.anon-sandbox" << FJWRAP
#!/bin/bash
exec firejail --quiet --caps.drop=all --no3d --nodvd --nosound \\
    --nogroups --nonewprivs --seccomp \\
    "${real_path}" "\$@"
FJWRAP
        chmod +x "${wrapper_dir}/${tool}.anon-sandbox"
    done
    info "Firejail sandboxed wrappers created for external tools"
}

_remove_firejail_wrappers() {
    local wrapper_dir="${WRAPPER_DIR:-/usr/local/bin}"
    rm -f "${wrapper_dir}"/*.anon-sandbox 2>/dev/null || true
    info "Firejail sandboxed wrappers removed"
}

start_sandbox_isolation() {
    source "${BASE_DIR}/assets/sources/config"
    local torrc_path="${TORRC:-/etc/tor/torrc}"

    if [[ "${sandbox_isolation_status:-Disable}" == "Enable" ]]; then
        warn "Sandbox Isolation is already active"
        return 0
    fi

    if ip -4 route show 2>/dev/null | grep -q '10\.200\.200\.'; then
        warn "Existing route overlaps 10.200.200.0/24; namespace routing may conflict."
    fi

    info "Setting up Kernel-level Network Namespace + MAC enforcement..."

    ip link del veth-anon 2>/dev/null || true
    ip netns del anon_jail 2>/dev/null || true

    ip netns add anon_jail
    ip netns exec anon_jail ip link set lo up

    mkdir -p "$NETNS_ETC_DIR" 2>/dev/null || true
    cat > "$NETNS_ETC_DIR/resolv.conf" << 'EOF'
# ANON Sandbox Isolation DNS (routed via veth-anon -> Tor DNSPort)
nameserver 10.200.200.1
EOF

    ip link add veth-anon type veth peer name veth-jail
    ip link set veth-jail netns anon_jail

    ip addr add 10.200.200.1/24 dev veth-anon
    ip link set veth-anon up

    ip netns exec anon_jail ip addr add 10.200.200.2/24 dev veth-jail
    ip netns exec anon_jail ip link set veth-jail up
    ip netns exec anon_jail ip route add default via 10.200.200.1

    iptables -t nat -C PREROUTING -i veth-anon -p tcp --dport 9050 -j ACCEPT 2>/dev/null \
        || iptables -t nat -A PREROUTING -i veth-anon -p tcp --dport 9050 -j ACCEPT
    iptables -t nat -C PREROUTING -i veth-anon -p tcp -j REDIRECT --to-ports 9040 2>/dev/null \
        || iptables -t nat -A PREROUTING -i veth-anon -p tcp -j REDIRECT --to-ports 9040
    iptables -t nat -C PREROUTING -i veth-anon -p udp --dport 53 -j REDIRECT --to-ports 5353 2>/dev/null \
        || iptables -t nat -A PREROUTING -i veth-anon -p udp --dport 53 -j REDIRECT --to-ports 5353
    iptables -t nat -C PREROUTING -i veth-anon -p tcp --dport 53 -j REDIRECT --to-ports 5353 2>/dev/null \
        || iptables -t nat -A PREROUTING -i veth-anon -p tcp --dport 53 -j REDIRECT --to-ports 5353

    iptables -C INPUT -i veth-anon -s 10.200.200.0/24 -p tcp -m multiport --dports 9040,9050,5353 -j ACCEPT 2>/dev/null \
        || iptables -I INPUT 1 -i veth-anon -s 10.200.200.0/24 -p tcp -m multiport --dports 9040,9050,5353 -j ACCEPT
    iptables -C INPUT -i veth-anon -s 10.200.200.0/24 -p udp --dport 5353 -j ACCEPT 2>/dev/null \
        || iptables -I INPUT 1 -i veth-anon -s 10.200.200.0/24 -p udp --dport 5353 -j ACCEPT

    if ! is_wsl; then
        sysctl -w net.ipv4.ip_forward=1 > /dev/null 2>&1 || true
    fi

    if [[ -f "$torrc_path" ]] && ! grep -q "10.200.200.1:9040" "$torrc_path" 2>/dev/null; then
        cat >> "$torrc_path" << 'EOF'
TransPort 10.200.200.1:9040 IsolateClientAddr IsolateClientProtocol IsolateDestAddr IsolateDestPort # ANON_SANDBOX
SocksPort 10.200.200.1:9050 # ANON_SANDBOX
DNSPort 10.200.200.1:5353 # ANON_SANDBOX
EOF
        if service_ctrl is-active tor.service; then
            service_ctrl restart tor.service || true
        fi
    fi

    info "Network namespace 'anon_jail' created and routed through Tor"

    _install_apparmor_profile
    _apply_firejail_wrappers

    set_module_status "sandbox_isolation" "Enable"
    msg "Sandbox Isolation active (Namespace + AppArmor + Firejail)"
}

stop_sandbox_isolation() {
    source "${BASE_DIR}/assets/sources/config"
    local torrc_path="${TORRC:-/etc/tor/torrc}"

    iptables -t nat -D PREROUTING -i veth-anon -p tcp --dport 9050 -j ACCEPT 2>/dev/null || true
    iptables -t nat -D PREROUTING -i veth-anon -p tcp -j REDIRECT --to-ports 9040 2>/dev/null || true
    iptables -t nat -D PREROUTING -i veth-anon -p udp --dport 53 -j REDIRECT --to-ports 5353 2>/dev/null || true
    iptables -t nat -D PREROUTING -i veth-anon -p tcp --dport 53 -j REDIRECT --to-ports 5353 2>/dev/null || true
    iptables -D INPUT -i veth-anon -s 10.200.200.0/24 -p tcp -m multiport --dports 9040,9050,5353 -j ACCEPT 2>/dev/null || true
    iptables -D INPUT -i veth-anon -s 10.200.200.0/24 -p udp --dport 5353 -j ACCEPT 2>/dev/null || true

    if [[ -f "$torrc_path" ]] && grep -q "ANON_SANDBOX" "$torrc_path" 2>/dev/null; then
        sed -i '/# ANON_SANDBOX$/d' "$torrc_path" 2>/dev/null || true
        if service_ctrl is-active tor.service; then
            service_ctrl restart tor.service || true
        fi
    fi

    ip link del veth-anon 2>/dev/null || true
    ip netns del anon_jail 2>/dev/null || true
    rm -rf "$NETNS_ETC_DIR" 2>/dev/null || true

    _remove_apparmor_profile
    _remove_firejail_wrappers

    set_module_status "sandbox_isolation" "Disable"
    info "Sandbox Isolation removed (Namespace + MAC profiles cleaned)"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    set -euo pipefail
    if [[ "${1:-}" == "start" ]]; then
        start_sandbox_isolation
    elif [[ "${1:-}" == "stop" ]]; then
        stop_sandbox_isolation
    fi
fi
