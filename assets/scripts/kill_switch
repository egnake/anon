#!/bin/bash

# ═══════════════════════════════════════════════════════════════════
# Atomic Network Kill Switch — iptables-restore
# ═══════════════════════════════════════════════════════════════════

start_kill_switch(){
    source "${BASE_DIR}/assets/sources/config"

    if [[ "${kill_switch_status:-Disable}" == "Enable" ]]; then
        warn "Network Kill Switch is already running."
        return 0
    fi

    # ── Backup current ruleset ───────────────────────────────────
    iptables-save > "$BACKUPDIR/iptables_killswitch.bak" 2>/dev/null || true
    if command -v ip6tables-save &>/dev/null; then
        ip6tables-save > "$BACKUPDIR/ip6tables_killswitch.bak" 2>/dev/null || true
    fi

    # ── Detect active anonymity daemon UIDs ──────────────────────
    local detected_tor_uid="" tor_rules=""
    if service_ctrl is-active tor.service || pgrep -x tor &>/dev/null; then
        detected_tor_uid="$(id -u debian-tor 2>/dev/null || id -u tor 2>/dev/null || id -u _tor 2>/dev/null || true)"
    fi
    if [[ -n "$detected_tor_uid" ]]; then
        tor_rules="-A OUTPUT -m owner --uid-owner ${detected_tor_uid} -j ACCEPT
-A OUTPUT -d 127.0.0.1/32 -p tcp --dport 9040 -j ACCEPT
-A OUTPUT -d 127.0.0.1/32 -p udp --dport 5353 -j ACCEPT
-A OUTPUT -d 127.0.0.1/32 -p tcp --dport 9050 -j ACCEPT"
    fi

    local i2p_rules=""
    if [[ "${i2p_integration_status:-Disable}" == "Enable" ]]; then
        local i2p_uid
        i2p_uid="$(id -u _i2pd 2>/dev/null || id -u i2pd 2>/dev/null || true)"
        if [[ -n "$i2p_uid" ]]; then
            i2p_rules="-A OUTPUT -m owner --uid-owner ${i2p_uid} -j ACCEPT
-A OUTPUT -d 127.0.0.1/32 -p tcp -m multiport --dports 4444,4446,7070 -j ACCEPT"
        fi
    fi

    local doh_rules=""
    if [[ "${doh_shield_status:-Disable}" == "Enable" ]]; then
        local doh_uid
        doh_uid="$(id -u _dnscrypt-proxy 2>/dev/null || id -u dnscrypt-proxy 2>/dev/null || true)"
        if [[ -n "$doh_uid" ]]; then
            doh_rules="-A OUTPUT -m owner --uid-owner ${doh_uid} -j ACCEPT"
        fi
        doh_rules+=$'\n'"-A OUTPUT -d 127.0.2.1/32 -p udp --dport 53 -j ACCEPT"$'\n'"-A OUTPUT -d 127.0.2.1/32 -p tcp --dport 53 -j ACCEPT"
    fi

    local sandbox_rules=""
    if [[ "${sandbox_isolation_status:-Disable}" == "Enable" ]]; then
        sandbox_rules="-A INPUT -i veth-anon -s 10.200.200.0/24 -p tcp -m multiport --dports 9040,9050,5353 -j ACCEPT
-A INPUT -i veth-anon -s 10.200.200.0/24 -p udp --dport 5353 -j ACCEPT"
    fi

    if ! is_wsl; then
        sysctl -w net.ipv6.conf.all.disable_ipv6=1 &>/dev/null || true
        sysctl -w net.ipv6.conf.default.disable_ipv6=1 &>/dev/null || true
    fi

    if command -v ip6tables-restore &>/dev/null; then
        ip6tables-restore <<IP6_RULES 2>/dev/null || true
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT DROP [0:0]
-A INPUT -i lo -j ACCEPT
-A OUTPUT -o lo -j ACCEPT
COMMIT
IP6_RULES
    fi

    if iptables-restore <<KILLSWITCH_RULES; then
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT DROP [0:0]

# Loopback — always allowed
-A INPUT -i lo -j ACCEPT
-A OUTPUT -o lo -j ACCEPT
${sandbox_rules}

# Established connections — critical for daemon responses
-A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
-A OUTPUT -m state --state ESTABLISHED -j ACCEPT

# Tor / I2P / DoH daemon rules (if active)
${tor_rules}
${i2p_rules}
${doh_rules}

# Prevent LAN DNS leaks: Drop any direct DNS attempts to local gateways
-A OUTPUT -d 10.0.0.0/8 -p udp --dport 53 -j DROP
-A OUTPUT -d 10.0.0.0/8 -p tcp --dport 53 -j DROP
-A OUTPUT -d 172.16.0.0/12 -p udp --dport 53 -j DROP
-A OUTPUT -d 172.16.0.0/12 -p tcp --dport 53 -j DROP
-A OUTPUT -d 192.168.0.0/16 -p udp --dport 53 -j DROP
-A OUTPUT -d 192.168.0.0/16 -p tcp --dport 53 -j DROP

# Loopback & local/WSL non-DNS traffic
-A OUTPUT -d 127.0.0.0/8 -j ACCEPT
-A OUTPUT -d 10.0.0.0/8 -j ACCEPT
-A OUTPUT -d 172.16.0.0/12 -j ACCEPT
-A OUTPUT -d 192.168.0.0/16 -j ACCEPT

COMMIT
KILLSWITCH_RULES
        set_module_status "kill_switch" "Enable"
        info "Network Kill Switch enabled (atomic IPv4+IPv6 iptables-restore). All non-Tor traffic blocked."
        if declare -F notify >/dev/null 2>&1; then
            notify "ANON Kill Switch" "Network Kill Switch active. All non-Tor traffic is blocked." "normal"
        fi
    else
        warn "Failed to apply Kill Switch rules. Restoring previous state..."
        if [[ -s "$BACKUPDIR/iptables_killswitch.bak" ]]; then
            iptables-restore < "$BACKUPDIR/iptables_killswitch.bak" 2>/dev/null || true
        fi
        if [[ -s "$BACKUPDIR/ip6tables_killswitch.bak" ]] && command -v ip6tables-restore &>/dev/null; then
            ip6tables-restore < "$BACKUPDIR/ip6tables_killswitch.bak" 2>/dev/null || true
        fi
        return 1
    fi
}

stop_kill_switch(){
    source "${BASE_DIR}/assets/sources/config"

    if [[ -s "$BACKUPDIR/iptables_killswitch.bak" ]]; then
        iptables-restore < "$BACKUPDIR/iptables_killswitch.bak" 2>/dev/null || true
    else
        warn "No non-empty Kill Switch backup found; resetting filter policy to ACCEPT."
        iptables -F 2>/dev/null || true
        iptables -P INPUT ACCEPT 2>/dev/null || true
        iptables -P FORWARD ACCEPT 2>/dev/null || true
        iptables -P OUTPUT ACCEPT 2>/dev/null || true
    fi
    rm -f "$BACKUPDIR/iptables_killswitch.bak"

    if [[ -s "$BACKUPDIR/ip6tables_killswitch.bak" ]] && command -v ip6tables-restore &>/dev/null; then
        ip6tables-restore < "$BACKUPDIR/ip6tables_killswitch.bak" 2>/dev/null || true
    elif command -v ip6tables &>/dev/null; then
        ip6tables -F 2>/dev/null || true
        ip6tables -P INPUT ACCEPT 2>/dev/null || true
        ip6tables -P FORWARD ACCEPT 2>/dev/null || true
        ip6tables -P OUTPUT ACCEPT 2>/dev/null || true
    fi
    rm -f "$BACKUPDIR/ip6tables_killswitch.bak"

    if ! is_wsl; then
        sysctl -w net.ipv6.conf.all.disable_ipv6=0 &>/dev/null || true
        sysctl -w net.ipv6.conf.default.disable_ipv6=0 &>/dev/null || true
    fi

    set_module_status "kill_switch" "Disable"
    info "Network Kill Switch disabled — original firewall rules restored."
}
