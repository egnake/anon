#!/bin/bash

start_tor_bridges(){
    source /usr/share/anon/assets/sources/config

    if [[ "$tor_bridges_status" == "Disable" ]]; then
        # Check if obfs4proxy is installed
        if ! command -v obfs4proxy &> /dev/null; then
            err "obfs4proxy is not installed. Please run: sudo apt-get install obfs4proxy"
        fi

        echo -e "\n ${CYAN}ℹ INFO:${RESET} Please paste your Tor Bridge lines (obfs4) below."
        echo -e " ${DIM}Press [ENTER] on an empty line when you are done pasting.${RESET}\n"
        
        local temp_bridges=$(mktemp)
        while IFS= read -r line; do
            [[ -z "$line" ]] && break
            echo "$line" >> $temp_bridges
        done
        
        if [ -s $temp_bridges ]; then
            cat $temp_bridges > $SRCDIR/sources/bridges.txt
        fi
        rm -f $temp_bridges

        if [ -s $SRCDIR/sources/bridges.txt ]; then
            sed -i 's/tor_bridges_status="Disable"/tor_bridges_status="Enable"/g' $SRCDIR/sources/config
            info "Tor bridges successfully configured and enabled"
        else
            warn "No bridges were entered or saved. Tor bridges module was NOT enabled."
        fi
    else
        warn "Tor bridges is already enabled"
    fi
}

stop_tor_bridges(){
    source /usr/share/anon/assets/sources/config
    sed -i 's/tor_bridges_status="Enable"/tor_bridges_status="Disable"/g' $SRCDIR/sources/config
    info "Tor bridges successfully disabled (Bridges saved for next use)"
}
