#!/bin/bash

# ═══════════════════════════════════════════════════════════════════
# DNS Changer — Privacy-focused Non-logging DNS Resolvers
# ═══════════════════════════════════════════════════════════════════

start_dns_changer(){
    source "${BASE_DIR}/assets/sources/config"

    if [[ "${ip_changer_status:-Disable}" == "Enable" ]]; then
        warn "The Dns changer is not available while Ip changer is active."
        return 0
    fi
    if [[ "${doh_shield_status:-Disable}" == "Enable" ]]; then
        warn "The Dns changer is not available while DoH Shield is active."
        return 0
    fi

    if [[ "${dns_changer_status:-Disable}" == "Disable" ]]; then
        backup_resolv_conf "dns"
        lock_nm_dns

        # Privacy-hardened, non-logging DNS servers (Mullvad, Quad9, DNS.WATCH, UncensoredDNS)
        cat >"/etc/resolv.conf" <<EOF
# generated by anon
nameserver 194.242.2.2
nameserver 9.9.9.9
nameserver 84.200.69.80
nameserver 84.200.70.40
nameserver 91.239.100.100
nameserver 89.233.43.71
EOF
        chattr +i /etc/resolv.conf 2>/dev/null || true

        # Prevent IPv6 DNS leaks bypassing IPv4 privacy nameservers
        if command -v ip6tables &>/dev/null; then
            ip6tables -C OUTPUT -p udp --dport 53 -j DROP 2>/dev/null \
                || ip6tables -I OUTPUT 1 -p udp --dport 53 -j DROP 2>/dev/null || true
            ip6tables -C OUTPUT -p tcp --dport 53 -j DROP 2>/dev/null \
                || ip6tables -I OUTPUT 1 -p tcp --dport 53 -j DROP 2>/dev/null || true
        fi

        set_module_status "dns_changer" "Enable"
        info "Dns changer successfully enabled (Mullvad/Quad9/DNS.WATCH/UncensoredDNS)"
    else
        warn "Dns changer is already running"
    fi
}

stop_dns_changer(){
    source "${BASE_DIR}/assets/sources/config"
    if command -v ip6tables &>/dev/null; then
        ip6tables -D OUTPUT -p udp --dport 53 -j DROP 2>/dev/null || true
        ip6tables -D OUTPUT -p tcp --dport 53 -j DROP 2>/dev/null || true
    fi
    unlock_nm_dns
    restore_resolv_conf "dns"
    set_module_status "dns_changer" "Disable"
    info "Dns changer successfully disabled"
}
