#!/bin/bash

# ═══════════════════════════════════════════════════════════════════
# DNS Changer — Privacy-focused DNS Servers
# ═══════════════════════════════════════════════════════════════════

start_dns_changer(){
    source "${BASE_DIR}/assets/sources/config"

    if [[ "${ip_changer_status:-Disable}" == "Enable" ]]; then
        warn "The Dns changer is not available while Ip changer is active."
        return 0
    fi
    if [[ "${doh_shield_status:-Disable}" == "Enable" ]]; then
        warn "The Dns changer is not available while DoH Shield is active."
        return 0
    fi

    if [[ "${dns_changer_status:-Disable}" == "Disable" ]]; then
        chattr -i /etc/resolv.conf 2>/dev/null || true
        # Backup resolv.conf (handle symlinks properly)
        if [[ -L /etc/resolv.conf ]]; then
            cp -a /etc/resolv.conf "$BACKUPDIR/resolv.conf.symlink.bak"
            rm -f /etc/resolv.conf
        elif [[ -f /etc/resolv.conf ]]; then
            cat /etc/resolv.conf > "$BACKUPDIR/resolv.conf.bak"
        fi

        cat >"/etc/resolv.conf" <<EOF
# generated by anon
nameserver 84.200.69.80
nameserver 84.200.70.40
nameserver 91.239.100.100
nameserver 89.233.43.71
nameserver 208.67.222.222
nameserver 208.67.220.220
EOF
        sed -i 's/dns_changer_status="Disable"/dns_changer_status="Enable"/g' "$SRCDIR/sources/config"
        info "Dns changer successfully enabled"
    else
        warn "Dns changer is already running"
    fi
}

stop_dns_changer(){
    source "${BASE_DIR}/assets/sources/config"
    chattr -i /etc/resolv.conf 2>/dev/null || true
    if [[ -f "$BACKUPDIR/resolv.conf.symlink.bak" ]]; then
        rm -f /etc/resolv.conf
        mv "$BACKUPDIR/resolv.conf.symlink.bak" /etc/resolv.conf
    elif [[ -f "$BACKUPDIR/resolv.conf.bak" ]]; then
        cat "$BACKUPDIR/resolv.conf.bak" > /etc/resolv.conf
    fi
    rm -f "$BACKUPDIR/resolv.conf.bak" "$BACKUPDIR/resolv.conf.symlink.bak"
    sed -i 's/dns_changer_status="Enable"/dns_changer_status="Disable"/g' "$SRCDIR/sources/config"
    info "Dns changer successfully disabled"
}
