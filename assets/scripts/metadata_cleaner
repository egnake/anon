#!/bin/bash
set -euo pipefail

# ═══════════════════════════════════════════════════════════════════
# Metadata Cleaner — Forensic & Anti-Tracking Metadata Sanitizer
# Strips EXIF, GPS, author info, edit history, and sensitive tags
# from images, PDFs, audio, video, and office documents using MAT2
# (Metadata Anonymisation Toolkit v2) with fallback to ExifTool.
# ═══════════════════════════════════════════════════════════════════

_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -z "${BASE_DIR:-}" ]]; then
    if [[ -f "${_SCRIPT_DIR}/../sources/config" ]]; then
        BASE_DIR="$(cd "${_SCRIPT_DIR}/../.." && pwd)"
    elif [[ -f "/usr/share/anon/assets/sources/config" ]]; then
        BASE_DIR="/usr/share/anon"
    else
        BASE_DIR="$(cd "${_SCRIPT_DIR}/../.." && pwd)"
    fi
fi
export BASE_DIR

# Resolve configuration & notify helper
CFG_FILE=""
if [[ -f "${BASE_DIR}/assets/sources/config" ]]; then
    CFG_FILE="${BASE_DIR}/assets/sources/config"
elif [[ -f "/usr/share/anon/assets/sources/config" ]]; then
    CFG_FILE="/usr/share/anon/assets/sources/config"
fi

if [[ -n "$CFG_FILE" && -f "$CFG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CFG_FILE" 2>/dev/null || true
fi

_sanitize_file() {
    local file_path="$1"
    # Prevent option injection on filenames starting with '-'
    local safe_path="$file_path"
    [[ "$safe_path" == -* ]] && safe_path="./$safe_path"

    if command -v mat2 &>/dev/null; then
        if mat2 --inplace "$safe_path" 2>/dev/null; then
            return 0
        fi
        # Secondary per-file fallback to ExifTool if MAT2 does not support the format
        if command -v exiftool &>/dev/null; then
            if exiftool -all= -overwrite_original "$safe_path" 2>/dev/null; then
                return 0
            fi
        fi
        return 1
    elif command -v exiftool &>/dev/null; then
        if exiftool -all= -overwrite_original "$safe_path" 2>/dev/null; then
            return 0
        fi
        return 1
    fi
    return 2
}

clean_target() {
    local target="$1"

    if [[ ! -e "$target" ]]; then
        echo -e "\e[31m✖ ERROR: Target path does not exist: ${target}\e[0m" >&2
        return 1
    fi

    if ! command -v mat2 &>/dev/null && ! command -v exiftool &>/dev/null; then
        echo -e "\e[31m✖ ERROR: Neither 'mat2' nor 'exiftool' is installed.\e[0m" >&2
        echo -e "  Please install MAT2 or ExifTool:\n  \e[32msudo apt-get install -y mat2 libimage-exiftool-perl\e[0m" >&2
        return 1
    fi

    echo -e "\e[1;36m[*] Sanitizing metadata for: ${target}\e[0m"
    if command -v mat2 &>/dev/null; then
        echo -e "  \e[32m[+] Primary Engine:\e[0m MAT2 (Metadata Anonymisation Toolkit v2)"
    else
        echo -e "  \e[33m[+] Primary Engine:\e[0m ExifTool"
    fi

    local total=0
    local succeeded=0
    local failed=0

    if [[ -d "$target" ]]; then
        while IFS= read -r -d '' file_item; do
            ((total++)) || true
            if _sanitize_file "$file_item"; then
                ((succeeded++)) || true
            else
                ((failed++)) || true
                echo -e "  \e[33m⚠ WARNING:\e[0m Could not sanitize: ${file_item}" >&2
            fi
        done < <(find "$target" -type f -print0 2>/dev/null)

        if [[ "$total" -eq 0 ]]; then
            echo -e "  \e[33m⚠ WARNING:\e[0m Directory is empty (no files found): ${target}" >&2
            return 0
        fi
    else
        total=1
        if _sanitize_file "$target"; then
            succeeded=1
        else
            failed=1
        fi
    fi

    if [[ "$succeeded" -gt 0 && "$failed" -eq 0 ]]; then
        echo -e "\e[1;32m✔ SUCCESS: Metadata sanitized successfully for: ${target} (${succeeded}/${total} file(s))\e[0m"
        if declare -F notify >/dev/null 2>&1; then
            notify "ANON Metadata Cleaner" "Sanitized metadata for: $(basename "$target") (${succeeded}/${total})" "normal"
        fi
        return 0
    elif [[ "$succeeded" -gt 0 ]]; then
        echo -e "\e[33m⚠ WARNING: Partially sanitized ${target}: ${succeeded} succeeded, ${failed} skipped/failed.\e[0m" >&2
        return 1
    else
        echo -e "\e[31m✖ ERROR: Metadata sanitization failed for: ${target}\e[0m" >&2
        return 1
    fi
}

main() {
    if [[ $# -eq 0 || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: $0 <file-or-directory-path> [...]"
        exit 0
    fi

    local overall_rc=0
    for item in "$@"; do
        if ! clean_target "$item"; then
            overall_rc=1
        fi
    done
    exit "$overall_rc"
}

main "$@"
