#!/bin/bash
set -euo pipefail

# ═══════════════════════════════════════════════════════════════════
# Metadata Cleaner — Forensic & Anti-Tracking Metadata Sanitizer
# Strips EXIF, GPS, author info, edit history, and sensitive tags
# from images, PDFs, audio, video, and office documents using MAT2
# (Metadata Anonymisation Toolkit v2) with fallback to ExifTool.
# ═══════════════════════════════════════════════════════════════════

# Resolve configuration & notify helper
CFG_FILE=""
if [[ -f "/usr/share/anon/sources/config" ]]; then
    CFG_FILE="/usr/share/anon/sources/config"
elif [[ -f "${BASH_SOURCE[0]%/*}/../sources/config" ]]; then
    CFG_FILE="${BASH_SOURCE[0]%/*}/../sources/config"
fi

if [[ -n "$CFG_FILE" && -f "$CFG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CFG_FILE" 2>/dev/null || true
fi

clean_target() {
    local target="$1"

    if [[ ! -e "$target" ]]; then
        echo -e "\e[31m✖ ERROR: Target path does not exist: ${target}\e[0m" >&2
        return 1
    fi

    echo -e "\e[1;36m[*] Sanitizing metadata for: ${target}\e[0m"

    local cleaned=0

    # 1. Primary engine: MAT2 (Tails OS standard metadata cleaner)
    if command -v mat2 &>/dev/null; then
        echo -e "  \e[32m[+] Engine:\e[0m MAT2 (Metadata Anonymisation Toolkit v2)"
        if [[ -d "$target" ]]; then
            mat2 --inplace "$target"/* 2>/dev/null || mat2 "$target"/* 2>/dev/null || true
        else
            mat2 --inplace "$target" 2>/dev/null || mat2 "$target" 2>/dev/null || true
        fi
        cleaned=1

    # 2. Secondary fallback engine: ExifTool
    elif command -v exiftool &>/dev/null; then
        echo -e "  \e[33m[+] Engine:\e[0m ExifTool (Secondary fallback)"
        if [[ -d "$target" ]]; then
            exiftool -all= -overwrite_original -r "$target" 2>/dev/null || true
        else
            exiftool -all= -overwrite_original "$target" 2>/dev/null || true
        fi
        cleaned=1
    else
        echo -e "\e[31m✖ ERROR: Neither 'mat2' nor 'exiftool' is installed.\e[0m" >&2
        echo -e "  Please install MAT2 or ExifTool:\n  \e[32msudo apt-get install -y mat2 libimage-exiftool-perl\e[0m" >&2
        return 1
    fi

    if [[ "$cleaned" -eq 1 ]]; then
        echo -e "\e[1;32m✔ SUCCESS: Metadata sanitized successfully for: ${target}\e[0m"
        if declare -F notify >/dev/null 2>&1; then
            notify "ANON Metadata Cleaner" "Sanitized metadata for: $(basename "$target")" "normal"
        fi
        return 0
    fi
}

main() {
    if [[ $# -eq 0 || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: $0 <file-or-directory-path>"
        exit 0
    fi

    for item in "$@"; do
        clean_target "$item"
    done
}

main "$@"
