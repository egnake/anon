#!/bin/bash

# ═══════════════════════════════════════════════════════════════════
# Browser Anonymization — System-wide Firefox/LibreWolf Hardening
# ═══════════════════════════════════════════════════════════════════

_ANON_BROWSER_PREF_DIRS=(
    "/etc/firefox-esr"
    "/etc/firefox"
    "/etc/firefox/pref"
    "/etc/librewolf"
    "/usr/lib/firefox-esr/defaults/pref"
    "/usr/lib/firefox/defaults/pref"
    "/usr/lib/librewolf/defaults/pref"
)

start_browser_anonymization(){
    source "${BASE_DIR}/assets/sources/config"

    if [[ "${browser_anonymization_status:-Disable}" == "Disable" ]]; then
        local installed=0 dir
        for dir in "${_ANON_BROWSER_PREF_DIRS[@]}"; do
            if [[ -d "$dir" ]]; then
                cp "$SRCDIR/sources/anon.js" "$dir/anon.js" 2>/dev/null && installed=1
            fi
        done

        if [[ $installed -eq 1 ]]; then
            set_module_status "browser_anonymization" "Enable"
            info "Browser anonymization successfully enabled"
        else
            warn "No supported Firefox/LibreWolf directory found (checked /etc/firefox-esr, /etc/firefox, /etc/librewolf, etc.)"
        fi
    else
        warn "Browser anonymization is already running"
    fi
}

stop_browser_anonymization(){
    source "${BASE_DIR}/assets/sources/config"
    local dir
    for dir in "${_ANON_BROWSER_PREF_DIRS[@]}"; do
        rm -f "${dir}/anon.js" 2>/dev/null || true
    done
    set_module_status "browser_anonymization" "Disable"
    info "Browser anonymization successfully disabled"
}
