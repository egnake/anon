#!/bin/bash

# ═══════════════════════════════════════════════════════════════════
# DPI Spoofing — Tor Snowflake WebRTC Traffic Camouflage
# ═══════════════════════════════════════════════════════════════════

start_dpi_spoofing(){
    source "${BASE_DIR}/assets/sources/config"
    if [[ "${dpi_spoofing_status:-Disable}" == "Disable" ]]; then
        # Check if snowflake-client is installed
        if ! command -v snowflake-client &> /dev/null; then
            warn "snowflake-client is not installed. Attempting to install..."
            if command -v apt-get &>/dev/null; then
                apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y snowflake-client || {
                    warn "snowflake-client installation failed. Please run: sudo apt-get install snowflake-client"
                    return 1
                }
            else
                warn "snowflake-client is not installed and apt-get is unavailable. Please install snowflake-client manually."
                return 1
            fi
        fi

        sed -i 's/dpi_spoofing_status="Disable"/dpi_spoofing_status="Enable"/g' "$SRCDIR/sources/config"
        info "DPI Spoofing (Snowflake WebRTC Camouflage) successfully enabled."
        if [[ "${ip_changer_status:-Disable}" == "Enable" ]]; then
            info "Refreshing Tor transparent proxy configuration..."
            stop_ip_changer
            start_ip_changer
        fi
    else
        warn "DPI Spoofing is already enabled."
    fi
}

stop_dpi_spoofing(){
    source "${BASE_DIR}/assets/sources/config"
    sed -i 's/dpi_spoofing_status="Enable"/dpi_spoofing_status="Disable"/g' "$SRCDIR/sources/config"
    info "DPI Spoofing successfully disabled."
    if [[ "${ip_changer_status:-Disable}" == "Enable" ]]; then
        info "Refreshing Tor transparent proxy configuration..."
        stop_ip_changer
        start_ip_changer
    fi
}
