#!/bin/bash

# ═══════════════════════════════════════════════════════════════════
# Bluetooth Disabler — rfkill-based Bluetooth Kill
# ═══════════════════════════════════════════════════════════════════

start_bluetooth_disabler(){
    source "${BASE_DIR}/assets/sources/config"
    if [[ "${bluetooth_disabler_status:-Disable}" == "Disable" ]]; then
        if ! command -v rfkill &>/dev/null; then
            warn "rfkill not found; cannot disable Bluetooth."
            return 1
        fi
        local bt_state
        bt_state="$(rfkill list bluetooth 2>/dev/null || true)"
        if [[ -z "$bt_state" ]]; then
            warn "No Bluetooth radio detected by rfkill."
            return 1
        fi
        if ! echo "$bt_state" | grep -qi "Soft blocked: yes"; then
            touch "$BACKUPDIR/bluetooth_was_on"
        fi
        rfkill block bluetooth &> /dev/null || true
        set_module_status "bluetooth_disabler" "Enable"
        info "Bluetooth disabler successfully enabled (Blocked)"
    else
        warn "Bluetooth disabler is already running"
    fi
}

stop_bluetooth_disabler(){
    source "${BASE_DIR}/assets/sources/config"
    if [[ -f "$BACKUPDIR/bluetooth_was_on" ]]; then
        rfkill unblock bluetooth &> /dev/null || true
        rm -f "$BACKUPDIR/bluetooth_was_on"
    fi
    set_module_status "bluetooth_disabler" "Disable"
    info "Bluetooth disabler successfully disabled (Unblocked)"
}
