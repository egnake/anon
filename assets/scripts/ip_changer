#!/bin/bash

# ═══════════════════════════════════════════════════════════════════
# IP Changer — Atomic Tor Transparent Proxy Integration
# ═══════════════════════════════════════════════════════════════════

_append_bridges_to_torrc() {
    local target_torrc="$1"
    local bridges_file="$2"
    [[ -z "$bridges_file" || ! -f "$bridges_file" ]] && return 1

    while IFS= read -r bridge_line || [[ -n "$bridge_line" ]]; do
        bridge_line="${bridge_line%$'\r'}"
        [[ -z "${bridge_line//[[:space:]]/}" || "$bridge_line" == \#* ]] && continue
        if [[ "$bridge_line" != Bridge\ * ]]; then
            echo "Bridge $bridge_line" >> "$target_torrc"
        else
            echo "$bridge_line" >> "$target_torrc"
        fi
    done < "$bridges_file"
}

_apply_tor_iptables_atomic() {
    local tor_uid="$1"
    local sandbox_active="${2:-Disable}"

    local sandbox_nat=""
    local sandbox_in=""
    if [[ "$sandbox_active" == "Enable" ]]; then
        sandbox_nat="-A PREROUTING -i veth-anon -p tcp --dport 9050 -j ACCEPT
-A PREROUTING -i veth-anon -p tcp -j REDIRECT --to-ports 9040
-A PREROUTING -i veth-anon -p udp --dport 53 -j REDIRECT --to-ports 5353
-A PREROUTING -i veth-anon -p tcp --dport 53 -j REDIRECT --to-ports 5353"
        sandbox_in="-A INPUT -i veth-anon -s 10.200.200.0/24 -p tcp -m multiport --dports 9040,9050,5353 -j ACCEPT
-A INPUT -i veth-anon -s 10.200.200.0/24 -p udp --dport 5353 -j ACCEPT"
    fi

    iptables-restore <<TOR_IPTABLES_RULES
*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
${sandbox_nat}
-A OUTPUT -d 10.192.0.0/10 -p tcp -m tcp --tcp-flags FIN,SYN,RST,ACK SYN -j REDIRECT --to-ports 9040
-A OUTPUT -d 127.0.0.1/32 -p udp -m udp --dport 53 -j REDIRECT --to-ports 5353
-A OUTPUT -d 127.0.0.1/32 -p tcp -m tcp --dport 53 --tcp-flags FIN,SYN,RST,ACK SYN -j REDIRECT --to-ports 5353
-A OUTPUT -m owner --uid-owner ${tor_uid} -j RETURN
-A OUTPUT -o lo -j RETURN
-A OUTPUT -d 127.0.0.0/8 -j RETURN
-A OUTPUT -d 10.0.0.0/8 -j RETURN
-A OUTPUT -d 172.16.0.0/12 -j RETURN
-A OUTPUT -d 192.168.0.0/16 -j RETURN
-A OUTPUT -p udp -m udp --dport 53 -j REDIRECT --to-ports 5353
-A OUTPUT -p tcp -m tcp --tcp-flags FIN,SYN,RST,ACK SYN -j REDIRECT --to-ports 9040
COMMIT
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT DROP [0:0]
-A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
-A INPUT -i lo -j ACCEPT
${sandbox_in}
-A INPUT -j DROP
-A FORWARD -j DROP
-A OUTPUT -m conntrack --ctstate INVALID -j DROP
-A OUTPUT -m state --state INVALID -j DROP
-A OUTPUT -m state --state ESTABLISHED -j ACCEPT
-A OUTPUT -m owner --uid-owner ${tor_uid} -j ACCEPT
-A OUTPUT -d 10.0.0.0/8 -p udp --dport 53 -j DROP
-A OUTPUT -d 10.0.0.0/8 -p tcp --dport 53 -j DROP
-A OUTPUT -d 172.16.0.0/12 -p udp --dport 53 -j DROP
-A OUTPUT -d 172.16.0.0/12 -p tcp --dport 53 -j DROP
-A OUTPUT -d 192.168.0.0/16 -p udp --dport 53 -j DROP
-A OUTPUT -d 192.168.0.0/16 -p tcp --dport 53 -j DROP
-A OUTPUT -d 127.0.0.0/8 -j ACCEPT
-A OUTPUT -d 10.0.0.0/8 -j ACCEPT
-A OUTPUT -d 172.16.0.0/12 -j ACCEPT
-A OUTPUT -d 192.168.0.0/16 -j ACCEPT
-A OUTPUT -d 127.0.0.1/32 -o lo -j ACCEPT
-A OUTPUT -d 127.0.0.1/32 -p udp -m udp --dport 5353 -j ACCEPT
-A OUTPUT -d 127.0.0.1/32 -p tcp -m tcp --dport 9040 --tcp-flags FIN,SYN,RST,ACK SYN -j ACCEPT
-A OUTPUT -j DROP
COMMIT
TOR_IPTABLES_RULES

    if command -v ip6tables-restore &>/dev/null; then
        ip6tables-restore <<TOR_IP6_RULES 2>/dev/null || true
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT DROP [0:0]
-A INPUT -i lo -j ACCEPT
-A OUTPUT -o lo -j ACCEPT
COMMIT
TOR_IP6_RULES
    fi
}

start_ip_changer(){
    source "${BASE_DIR}/assets/sources/config"
    local torrc_path="${TORRC:-/etc/tor/torrc}"

    if [[ "${dns_changer_status:-Disable}" != "Disable" || "${doh_shield_status:-Disable}" != "Disable" ]]; then
        warn "The Ip changer is not available. (Dns changer or DoH Shield enabled)"
        return 0
    fi

    if [[ "${ip_changer_status:-Disable}" == "Enable" ]]; then
        warn "Ip changer is already running"
        return 0
    fi

    # Backup current firewall, torrc, and resolv.conf state
    cat "$torrc_path" > "$BACKUPDIR/torrc.bak" 2>/dev/null || touch "$BACKUPDIR/torrc.bak"
    backup_resolv_conf "tor"
    iptables-save > "$BACKUPDIR/iptables.rules.bak" 2>/dev/null || true
    ip6tables-save > "$BACKUPDIR/ip6tables.rules.bak" 2>/dev/null || true

    local current_tor_uid
    current_tor_uid="$(id -u debian-tor 2>/dev/null || id -u tor 2>/dev/null || id -u _tor 2>/dev/null || echo "109")"

    if ! _apply_tor_iptables_atomic "$current_tor_uid" "${sandbox_isolation_status:-Disable}"; then
        warn "Failed to apply atomic Tor iptables rules."
        return 1
    fi

    cat >"$torrc_path" <<EOF
VirtualAddrNetworkIPv4 10.192.0.0/10
AutomapHostsOnResolve 1
TransPort 9040 IsolateClientAddr IsolateClientProtocol IsolateDestAddr IsolateDestPort
SocksPort 9050
DNSPort 5353
ControlPort 9051
CookieAuthentication 1
EOF
    if [[ "${sandbox_isolation_status:-Disable}" == "Enable" ]]; then
        cat >>"$torrc_path" <<'EOF'
TransPort 10.200.200.1:9040 IsolateClientAddr IsolateClientProtocol IsolateDestAddr IsolateDestPort # ANON_SANDBOX
SocksPort 10.200.200.1:9050 # ANON_SANDBOX
DNSPort 10.200.200.1:5353 # ANON_SANDBOX
EOF
    fi

    # Append bridges or Snowflake camouflage if enabled
    local active_bridges_file
    active_bridges_file="$(resolve_bridges_file)"
    local snowflake_bin obfs4_bin
    snowflake_bin="$(command -v snowflake-client 2>/dev/null || echo "/usr/bin/snowflake-client")"
    obfs4_bin="$(command -v obfs4proxy 2>/dev/null || echo "/usr/bin/obfs4proxy")"

    if [[ "${dpi_spoofing_status:-Disable}" == "Enable" ]]; then
        echo "UseBridges 1" >> "$torrc_path"
        echo "ClientTransportPlugin snowflake exec ${snowflake_bin} -url https://snowflake-broker.torproject.net.global.prod.fastly.net/ -front cdn.sstatic.net -ice stun:stun.voip.blackberry.com:3478,stun:stun.altar.com.pl:3478,stun:stun.antisip.com:3478,stun:stun.bluesip.net:3478,stun:stun.dus.net:3478,stun:stun.epygi.com:3478,stun:stun.sonetel.com:3478,stun:stun.uls.co.za:3478,stun:stun.voys.nl:3478 -max 3" >> "$torrc_path"
        echo "Bridge snowflake 192.0.2.3:1 2B280B23E1107BB62ABFC40DDCC8824814F80A72" >> "$torrc_path"
    elif [[ "${tor_bridges_status:-Disable}" == "Enable" ]] && [[ -n "$active_bridges_file" ]]; then
        echo "UseBridges 1" >> "$torrc_path"
        echo "ClientTransportPlugin obfs4 exec ${obfs4_bin}" >> "$torrc_path"
        _append_bridges_to_torrc "$torrc_path" "$active_bridges_file"
    fi

    # Lock NetworkManager & nsswitch against DNS bypass and set loopback resolver
    lock_nm_dns
    chattr -i /etc/resolv.conf 2>/dev/null || true
    cat >"/etc/resolv.conf" 2>/dev/null <<EOF || true
# This file was edited by anon. Do not change manually!
nameserver 127.0.0.1
EOF
    chattr +i /etc/resolv.conf 2>/dev/null || true
    service_ctrl daemon-reload || true

    if service_ctrl is-active tor.service; then
        service_ctrl stop tor.service || true
    fi

    if ! is_wsl; then
        sysctl -w net.ipv6.conf.all.disable_ipv6=1 &> /dev/null || true
        sysctl -w net.ipv6.conf.default.disable_ipv6=1 &> /dev/null || true
    fi
    service_ctrl start tor.service || true
    set_module_status "ip_changer" "Enable"
    info "Ip changer successfully enabled"

    # Automated Leak Test
    info "Running automated leak test..."
    sleep 3
    local retries=3 success=0 i
    for i in $(seq 1 $retries); do
        info "Leak test attempt $i/$retries..."
        if curl -s --max-time 15 https://check.torproject.org/api/ip | grep -q '"IsTor":true'; then
            msg "No IP leaks detected! You are successfully routed through Tor."
            if declare -F notify >/dev/null 2>&1; then
                notify "ANON - Tor Connected" "Transparent proxy active. No leaks detected." "normal"
            fi
            success=1
            break
        else
            warn "Leak test failed or timed out. Retrying in 5 seconds..."
            sleep 5
        fi
    done

    if [[ "$success" -eq 0 ]]; then
        active_bridges_file="$(resolve_bridges_file)"
        # Only fall back to obfs4 if neither Snowflake nor obfs4 is already configured
        if [[ "${dpi_spoofing_status:-Disable}" == "Disable" && "${tor_bridges_status:-Disable}" == "Disable" && -n "$active_bridges_file" ]]; then
            warn "Tor connection failed. Attempting Auto-Fallback to Tor Bridges..."
            set_module_status "tor_bridges" "Enable"
            info "Bridges enabled. Restarting Tor..."

            echo "UseBridges 1" >> "$torrc_path"
            echo "ClientTransportPlugin obfs4 exec ${obfs4_bin}" >> "$torrc_path"
            _append_bridges_to_torrc "$torrc_path" "$active_bridges_file"

            service_ctrl restart tor.service || true
            info "Tor restarted with Obfs4 Bridges. Retrying leak test..."

            sleep 5
            local fallback_success=0 j
            for j in $(seq 1 $retries); do
                info "Fallback test attempt $j/$retries..."
                if curl -s --max-time 15 https://check.torproject.org/api/ip | grep -q '"IsTor":true'; then
                    msg "Auto-Fallback successful! Connected via Tor Bridges."
                    if declare -F notify >/dev/null 2>&1; then
                        notify "ANON - Bridges Active" "Connected to Tor via obfuscated bridges." "normal"
                    fi
                    fallback_success=1
                    break
                else
                    warn "Fallback test failed. Retrying in 5 seconds..."
                    sleep 5
                fi
            done

            if [[ "$fallback_success" -eq 0 ]]; then
                warn "CRITICAL: Auto-Fallback failed. Tor is completely blocked! Triggering Kill Switch..."
                if declare -F notify >/dev/null 2>&1; then
                    notify "ANON - CRITICAL ALERT" "Tor bridges blocked! Kill switch engaged." "critical"
                fi
                set_module_status "ip_changer" "Disable"
                source "$SRCDIR/scripts/kill_switch"
                start_kill_switch
                warn "Network locked down. Check your network or update your bridges."
                return 1
            fi
        else
            warn "CRITICAL: IP Leak detected or Tor connection failed! Triggering Kill Switch for safety..."
            if declare -F notify >/dev/null 2>&1; then
                notify "ANON - CRITICAL ALERT" "IP Leak detected! Kill switch engaged." "critical"
            fi
            set_module_status "ip_changer" "Disable"
            source "$SRCDIR/scripts/kill_switch"
            start_kill_switch
            warn "Network locked down to prevent leaks. Please check your Tor connection and restart."
            return 1
        fi
    fi
}

stop_ip_changer(){
    source "${BASE_DIR}/assets/sources/config"
    local torrc_path="${TORRC:-/etc/tor/torrc}"

    service_ctrl stop tor.service || true

    if [[ -s "$BACKUPDIR/iptables.rules.bak" ]]; then
        iptables-restore < "$BACKUPDIR/iptables.rules.bak" 2>/dev/null || true
    else
        iptables -F 2>/dev/null || true
        iptables -X 2>/dev/null || true
        iptables -t nat -F 2>/dev/null || true
        iptables -t nat -X 2>/dev/null || true
        iptables -P INPUT ACCEPT 2>/dev/null || true
        iptables -P FORWARD ACCEPT 2>/dev/null || true
        iptables -P OUTPUT ACCEPT 2>/dev/null || true
    fi

    # Preserve sandbox_isolation NAT/INPUT rules if sandbox_isolation is still active
    if [[ "${sandbox_isolation_status:-Disable}" == "Enable" ]] && ip netns list 2>/dev/null | grep -qw "anon_jail"; then
        iptables -t nat -C PREROUTING -i veth-anon -p tcp --dport 9050 -j ACCEPT 2>/dev/null \
            || iptables -t nat -A PREROUTING -i veth-anon -p tcp --dport 9050 -j ACCEPT 2>/dev/null || true
        iptables -t nat -C PREROUTING -i veth-anon -p tcp -j REDIRECT --to-ports 9040 2>/dev/null \
            || iptables -t nat -A PREROUTING -i veth-anon -p tcp -j REDIRECT --to-ports 9040 2>/dev/null || true
        iptables -t nat -C PREROUTING -i veth-anon -p udp --dport 53 -j REDIRECT --to-ports 5353 2>/dev/null \
            || iptables -t nat -A PREROUTING -i veth-anon -p udp --dport 53 -j REDIRECT --to-ports 5353 2>/dev/null || true
        iptables -t nat -C PREROUTING -i veth-anon -p tcp --dport 53 -j REDIRECT --to-ports 5353 2>/dev/null \
            || iptables -t nat -A PREROUTING -i veth-anon -p tcp --dport 53 -j REDIRECT --to-ports 5353 2>/dev/null || true
    fi

    if command -v ip6tables-restore &>/dev/null && [[ -s "$BACKUPDIR/ip6tables.rules.bak" ]]; then
        ip6tables-restore < "$BACKUPDIR/ip6tables.rules.bak" 2>/dev/null || true
    elif command -v ip6tables &>/dev/null; then
        ip6tables -F 2>/dev/null || true
        ip6tables -P INPUT ACCEPT 2>/dev/null || true
        ip6tables -P FORWARD ACCEPT 2>/dev/null || true
        ip6tables -P OUTPUT ACCEPT 2>/dev/null || true
    fi

    if ! is_wsl; then
        sysctl -w net.ipv6.conf.all.disable_ipv6=0 &> /dev/null || true
        sysctl -w net.ipv6.conf.default.disable_ipv6=0 &> /dev/null || true
    fi

    if [[ -f "$BACKUPDIR/torrc.bak" ]]; then
        cat "$BACKUPDIR/torrc.bak" > "$torrc_path"
    fi
    unlock_nm_dns
    restore_resolv_conf "tor"
    rm -f "$BACKUPDIR/torrc.bak" "$BACKUPDIR/iptables.rules.bak" "$BACKUPDIR/ip6tables.rules.bak"
    set_module_status "ip_changer" "Disable"
    info "Ip changer successfully disabled"
}
