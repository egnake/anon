#!/bin/bash

# ═══════════════════════════════════════════════════════════════════
# MAC Changer — Randomized Locally-Administered MAC Address
# ═══════════════════════════════════════════════════════════════════

_is_virtual_mac_iface() {
    case "$1" in
        lo|veth*|docker*|br-*|virbr*|tun*|tap*|wg*|anon*) return 0 ;;
        *) return 1 ;;
    esac
}

_is_vm_or_wsl() {
    is_wsl && return 0
    if command -v dmidecode &>/dev/null; then
        local mfg prod
        mfg="$(dmidecode -s system-manufacturer 2>/dev/null || true)"
        prod="$(dmidecode -s system-product-name 2>/dev/null || true)"
        case "$mfg" in
            *"innotek"*|*"VMware"*|*"QEMU"*|*"Xen"*|*"Microsoft Corporation"*|*"Parallels"*) return 0 ;;
        esac
        case "$prod" in
            *"VirtualBox"*|*"VMware"*|*"KVM"*|*"Bochs"*|*"HVM"*|*"Virtual Machine"*) return 0 ;;
        esac
    fi
    return 1
}

start_mac_changer(){
    source "${BASE_DIR}/assets/sources/config"

    if [[ "${mac_changer_status:-Disable}" != "Disable" ]]; then
        warn "Mac changer is already running"
        return 0
    fi

    mkdir -p "$BACKUPDIR/mac_addresses"

    local raw_ifaces IFACE
    local -a IFACES=()
    raw_ifaces=$(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | cut -d'@' -f1 || true)
    while IFS= read -r IFACE; do
        [[ -z "$IFACE" ]] && continue
        _is_virtual_mac_iface "$IFACE" && continue
        IFACES+=("$IFACE")
        if [[ -f "/sys/class/net/$IFACE/address" ]]; then
            cat "/sys/class/net/$IFACE/address" > "$BACKUPDIR/mac_addresses/$IFACE" 2>/dev/null || true
        fi
    done <<< "$raw_ifaces"

    local changed=0

    changer_func(){
        local target_iface="$1"
        local orig_mac=""
        [[ -f "/sys/class/net/$target_iface/address" ]] && orig_mac="$(cat "/sys/class/net/$target_iface/address" 2>/dev/null || true)"

        # Authentic hardware vendor OUIs (Apple, Intel, Dell, Samsung, Cisco, HP, Lenovo, Asus, Realtek)
        local -a vendor_ouis=(
            "00:17:f2" "3c:07:54" "a4:83:e7" "f0:18:98"
            "00:1b:21" "00:21:6a" "34:13:e8" "68:05:ca"
            "00:14:22" "18:66:da" "ec:f4:bb" "f8:bc:12"
            "00:26:37" "34:23:ba" "50:56:bf" "e4:58:b8"
            "00:1a:a1" "00:25:84" "58:97:bd"
            "00:1e:0b" "3c:d9:2b" "70:5a:0f"
            "00:59:07" "60:99:d1" "80:2b:f9"
            "04:92:26" "2c:4d:54" "70:8b:cd"
            "00:e0:4c" "52:54:00" "b8:8a:ec"
        )

        local attempts=0 out="" spoof_ok=0
        while [[ $attempts -lt 10 ]]; do
            ((attempts++))
            local oui="${vendor_ouis[$((RANDOM % ${#vendor_ouis[@]}))]}"
            local d1 d2 d3
            d1="$(tr -dc '0-9a-f' </dev/urandom 2>/dev/null | head -c 2 || printf "%02x" $((RANDOM % 256)))"
            d2="$(tr -dc '0-9a-f' </dev/urandom 2>/dev/null | head -c 2 || printf "%02x" $((RANDOM % 256)))"
            d3="$(tr -dc '0-9a-f' </dev/urandom 2>/dev/null | head -c 2 || printf "%02x" $((RANDOM % 256)))"
            out="${oui}:${d1}:${d2}:${d3}"

            ip link set "$target_iface" down 2>/dev/null || true
            if ip link set "$target_iface" address "$out" 2>/dev/null; then
                ip link set "$target_iface" up 2>/dev/null || true
                spoof_ok=1
                break
            else
                # Fallback to random locally-administered unicast MAC
                local hex_chars="0123456789abcdef"
                local first_hex="${hex_chars:$((RANDOM%16)):1}"
                local -a second_hex_opts=("2" "6" "a" "e")
                local second_hex="${second_hex_opts[$((RANDOM%4))]}"
                local e1 e2
                e1="$(tr -dc '0-9a-f' </dev/urandom 2>/dev/null | head -c 2 || printf "%02x" $((RANDOM % 256)))"
                e2="$(tr -dc '0-9a-f' </dev/urandom 2>/dev/null | head -c 2 || printf "%02x" $((RANDOM % 256)))"
                out="${first_hex}${second_hex}:${d1}:${d2}:${d3}:${e1}:${e2}"
                if ip link set "$target_iface" address "$out" 2>/dev/null; then
                    ip link set "$target_iface" up 2>/dev/null || true
                    spoof_ok=1
                    break
                fi
            fi
            ip link set "$target_iface" up 2>/dev/null || true
        done

        if [[ $spoof_ok -eq 1 ]]; then
            local new_mac=""
            [[ -f "/sys/class/net/$target_iface/address" ]] && new_mac="$(cat "/sys/class/net/$target_iface/address" 2>/dev/null || true)"
            if [[ -z "$orig_mac" || "$new_mac" != "$orig_mac" || "$new_mac" == "$out" ]]; then
                changed=1
                info "Mac changer enabled for ${target_iface} (Spoofed to: ${out})"
            else
                warn "Driver ignored MAC change on ${target_iface} (remained ${new_mac})"
            fi
        else
            warn "Failed to assign spoofed MAC on ${target_iface}"
        fi
    }

    if _is_vm_or_wsl; then
        if nmcli dev 2>/dev/null | grep -qi wifi; then
            for IFACE in "${IFACES[@]}"; do
                if [[ "$IFACE" != "eth0" && "$IFACE" != "ens33" && "$IFACE" != "enp0s3" ]]; then
                    changer_func "$IFACE"
                fi
            done
        else
            warn "Virtual machine (or WSL) detected. No suitable wireless interface found for safe MAC spoofing."
        fi
    else
        for IFACE in "${IFACES[@]}"; do
            changer_func "$IFACE"
        done
    fi

    if [[ $changed -eq 1 ]]; then
        wait_for_network 4 >/dev/null 2>&1 || true
        set_module_status "mac_changer" "Enable"
    else
        warn "MAC Changer could not modify any physical interface."
    fi
}

stop_mac_changer(){
    source "${BASE_DIR}/assets/sources/config"
    if [[ -d "$BACKUPDIR/mac_addresses" ]]; then
        local device devname orig_mac
        for device in "$BACKUPDIR/mac_addresses"/*; do
            [[ -f "$device" ]] || continue
            devname="$(basename "$device")"
            orig_mac="$(cat "$device" 2>/dev/null || true)"
            [[ -z "$orig_mac" ]] && continue
            ip link set "$devname" down 2>/dev/null || true
            ip link set "$devname" address "$orig_mac" 2>/dev/null || true
            ip link set "$devname" up 2>/dev/null || true
        done
        rm -rf "$BACKUPDIR/mac_addresses"
        wait_for_network 4 >/dev/null 2>&1 || true
    fi
    set_module_status "mac_changer" "Disable"
    info "Mac changer successfully disabled"
}
