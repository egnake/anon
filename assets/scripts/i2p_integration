#!/bin/bash

# ═══════════════════════════════════════════════════════════════════
# I2P Integration — i2pd Router Daemon
# ═══════════════════════════════════════════════════════════════════

start_i2p_integration(){
    source "${BASE_DIR}/assets/sources/config"
    if [[ "${i2p_integration_status:-Disable}" == "Disable" ]]; then
        info "Starting I2P Router daemon (i2pd)..."

        service_ctrl start i2pd || true
        sleep 2

        if service_ctrl is-active i2pd; then
            set_module_status "i2p_integration" "Enable"
            info "I2P Router successfully started."
            info "I2P SOCKS5 proxy available at 127.0.0.1:4446"
            info "I2P HTTP proxy available at 127.0.0.1:4444"
            info "I2P Web Console available at http://127.0.0.1:7070"
        else
            warn "Failed to start i2pd service. Is it installed?"
        fi
    else
        warn "I2P integration is already running"
    fi
}

stop_i2p_integration(){
    source "${BASE_DIR}/assets/sources/config"
    service_ctrl stop i2pd || true
    set_module_status "i2p_integration" "Disable"
    info "I2P Router successfully disabled"
}
