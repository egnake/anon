#!/bin/bash

# ═══════════════════════════════════════════════════════════════════
# Fix — System Backup & Full State Recovery Utilities
# ═══════════════════════════════════════════════════════════════════

_is_virtual_iface() {
    local ifname="$1"
    case "$ifname" in
        lo|veth*|docker*|br-*|virbr*|tun*|tap*|wg*|anon*) return 0 ;;
        *) return 1 ;;
    esac
}

get_backups(){
    mkdir -p "$BACKUPDIR"

    if [[ -L /etc/resolv.conf ]]; then
        cp -a /etc/resolv.conf "$BACKUPDIR/resolv.conf.symlink.bak" 2>/dev/null || true
        cat /etc/resolv.conf > "$BACKUPDIR/resolv.conf.bak" 2>/dev/null || true
    elif [[ -f /etc/resolv.conf ]]; then
        cat /etc/resolv.conf > "$BACKUPDIR/resolv.conf.bak" 2>/dev/null || true
    fi

    cat /etc/hostname > "$BACKUPDIR/hostname.bak" 2>/dev/null || hostname > "$BACKUPDIR/hostname.bak" 2>/dev/null || true
    if [[ -f /etc/hosts ]]; then
        cat /etc/hosts > "$BACKUPDIR/hosts.bak" 2>/dev/null || true
    fi
    if [[ -f "${TORRC:-/etc/tor/torrc}" ]]; then
        cat "$TORRC" > "$BACKUPDIR/torrc.bak" 2>/dev/null || true
    fi

    if iptables-save > "$BACKUPDIR/iptables.rules.tmp" 2>/dev/null && [[ -s "$BACKUPDIR/iptables.rules.tmp" ]]; then
        mv -f "$BACKUPDIR/iptables.rules.tmp" "$BACKUPDIR/iptables.rules.bak"
    else
        rm -f "$BACKUPDIR/iptables.rules.tmp"
    fi

    if command -v ip6tables-save &>/dev/null; then
        if ip6tables-save > "$BACKUPDIR/ip6tables.rules.tmp" 2>/dev/null && [[ -s "$BACKUPDIR/ip6tables.rules.tmp" ]]; then
            mv -f "$BACKUPDIR/ip6tables.rules.tmp" "$BACKUPDIR/ip6tables.rules.bak"
        else
            rm -f "$BACKUPDIR/ip6tables.rules.tmp"
        fi
    fi

    mkdir -p "$BACKUPDIR/mac_addresses"
    local IFACES IFACE
    IFACES=$(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | cut -d'@' -f1 || true)
    while IFS= read -r IFACE; do
        [[ -z "$IFACE" ]] && continue
        if ! _is_virtual_iface "$IFACE" && [[ -f "/sys/class/net/$IFACE/address" ]]; then
            cat "/sys/class/net/$IFACE/address" > "$BACKUPDIR/mac_addresses/$IFACE" 2>/dev/null || true
        fi
    done <<< "$IFACES"

    if command -v timedatectl &>/dev/null; then
        timedatectl show 2>/dev/null | grep Timezone | sed 's/Timezone=//g' > "$BACKUPDIR/timezone.bak" || true
    fi
    if [[ ! -s "$BACKUPDIR/timezone.bak" && -f /etc/timezone ]]; then
        cat /etc/timezone > "$BACKUPDIR/timezone.bak" 2>/dev/null || true
    fi

    if ( cd "$BACKUPDIR" && tar -czf anon_fix_backups.tar.gz -- *.bak mac_addresses 2>/dev/null ); then
        rm -rf "$BACKUPDIR"/*.bak "$BACKUPDIR/mac_addresses"
    fi
}

restore_system(){
    source "${BASE_DIR}/assets/sources/config"
    rm -rf "$BACKUPDIR"/*.bak "$BACKUPDIR/mac_addresses"

    if [[ -s "$BACKUPDIR/anon_fix_backups.tar.gz" ]]; then
        ( cd "$BACKUPDIR" && tar -xzf "$BACKUPDIR/anon_fix_backups.tar.gz" 2>/dev/null )
    fi

    # Unlock NetworkManager DNS override & restore /etc/nsswitch.conf
    unlock_nm_dns
    chattr -i /etc/resolv.conf 2>/dev/null || true

    if [[ -f "$BACKUPDIR/resolv.conf.symlink.bak" || -L "$BACKUPDIR/resolv.conf.symlink.bak" ]]; then
        rm -f /etc/resolv.conf
        mv -f "$BACKUPDIR/resolv.conf.symlink.bak" /etc/resolv.conf
    elif [[ -s "$BACKUPDIR/resolv.conf.bak" ]]; then
        cat "$BACKUPDIR/resolv.conf.bak" > /etc/resolv.conf
    fi

    if [[ -s "$BACKUPDIR/hostname.bak" ]]; then
        local restore_hostname
        restore_hostname="$(cat "$BACKUPDIR/hostname.bak")"
        echo "$restore_hostname" > /etc/hostname 2>/dev/null || true
        hostname "$restore_hostname" 2>/dev/null || true
        if command -v hostnamectl &>/dev/null; then
            hostnamectl set-hostname "$restore_hostname" 2>/dev/null || true
        fi
    fi

    if [[ -s "$BACKUPDIR/hosts.bak" ]]; then
        cat "$BACKUPDIR/hosts.bak" > /etc/hosts 2>/dev/null || true
    fi

    if [[ -f "$BACKUPDIR/torrc.bak" && -n "${TORRC:-}" ]]; then
        cat "$BACKUPDIR/torrc.bak" > "$TORRC" 2>/dev/null || true
    fi

    # Unblock wireless radios & clean up tc qdiscs before restoring firewall/interfaces
    if command -v rfkill &>/dev/null; then
        rfkill unblock all 2>/dev/null || true
    fi

    local ifaces iface
    ifaces=$(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | cut -d'@' -f1 || true)
    while IFS= read -r iface; do
        [[ -z "$iface" || "$iface" == "lo" ]] && continue
        tc qdisc del dev "$iface" root 2>/dev/null || true
        ip link set "$iface" up 2>/dev/null || true
    done <<< "$ifaces"

    # Tear down isolated network namespace, Firejail/process wrappers, and AppArmor profile
    ip link del veth-anon 2>/dev/null || true
    ip netns del anon_jail 2>/dev/null || true
    rm -rf /etc/netns/anon_jail 2>/dev/null || true
    local aa_profile="${APPARMOR_TOR_PROFILE:-/etc/apparmor.d/usr.bin.tor.anon}"
    if [[ -f "$aa_profile" ]]; then
        if command -v apparmor_parser &>/dev/null; then
            apparmor_parser -R "$aa_profile" 2>/dev/null || true
        fi
        rm -f "$aa_profile" 2>/dev/null || true
    fi
    rm -f /usr/local/bin/*.anon-sandbox 2>/dev/null || true

    local bin_name
    for bin_name in nmap sqlmap; do
        if grep -qE "ANON_PROC_WRAPPER|systemd-kworker|systemd_kworker" "/usr/local/bin/${bin_name}" 2>/dev/null; then
            rm -f "/usr/local/bin/${bin_name}" 2>/dev/null || true
        fi
        if [[ -e "$BACKUPDIR/local_bin_${bin_name}.bak" ]]; then
            mv -f "$BACKUPDIR/local_bin_${bin_name}.bak" "/usr/local/bin/${bin_name}" 2>/dev/null || true
        fi
    done

    # Unmount volatile /var/log tmpfs & remount /proc with hidepid=0 if active
    if [[ "$(findmnt -n -o FSTYPE /var/log 2>/dev/null || true)" == "tmpfs" ]]; then
        umount -l /var/log 2>/dev/null || true
        service_ctrl restart systemd-journald || true
        service_ctrl restart rsyslog || true
    fi
    if [[ -f "$BACKUPDIR/proc_mount_opts.bak" ]]; then
        local orig_opts
        orig_opts=$(cat "$BACKUPDIR/proc_mount_opts.bak" 2>/dev/null || true)
        if [[ -n "$orig_opts" && "$orig_opts" != *"hidepid="* ]]; then
            mount -o "remount,${orig_opts},hidepid=0" /proc 2>/dev/null || mount -o remount,hidepid=0 /proc 2>/dev/null || true
        else
            mount -o "remount,${orig_opts:-rw,hidepid=0}" /proc 2>/dev/null || true
        fi
    elif mount 2>/dev/null | grep -q 'on /proc .*hidepid=2'; then
        mount -o remount,hidepid=0 /proc 2>/dev/null || true
    fi

    # Remove hardened browser pref drop-ins if present
    local pref_file
    for pref_file in /etc/firefox/anon.js /etc/firefox-esr/anon.js /etc/librewolf/anon.js \
                     /etc/firefox/pref/anon.js /etc/firefox-esr/pref/anon.js; do
        rm -f "$pref_file" 2>/dev/null || true
    done

    # Restore non-empty iptables backups, otherwise flush & set ACCEPT
    if [[ -s "$BACKUPDIR/iptables.rules.bak" ]]; then
        iptables-restore < "$BACKUPDIR/iptables.rules.bak" 2>/dev/null || true
    else
        iptables -F 2>/dev/null || true
        iptables -X 2>/dev/null || true
        iptables -t nat -F 2>/dev/null || true
        iptables -P INPUT ACCEPT 2>/dev/null || true
        iptables -P FORWARD ACCEPT 2>/dev/null || true
        iptables -P OUTPUT ACCEPT 2>/dev/null || true
    fi

    if command -v ip6tables-restore &>/dev/null; then
        if [[ -s "$BACKUPDIR/ip6tables.rules.bak" ]]; then
            ip6tables-restore < "$BACKUPDIR/ip6tables.rules.bak" 2>/dev/null || true
        else
            ip6tables -F 2>/dev/null || true
            ip6tables -P INPUT ACCEPT 2>/dev/null || true
            ip6tables -P FORWARD ACCEPT 2>/dev/null || true
            ip6tables -P OUTPUT ACCEPT 2>/dev/null || true
        fi
    fi

    if ! is_wsl; then
        sysctl -w net.ipv6.conf.all.disable_ipv6=0 &>/dev/null || true
        sysctl -w net.ipv6.conf.default.disable_ipv6=0 &>/dev/null || true
    fi

    if [[ -d "$BACKUPDIR/mac_addresses" ]]; then
        local device devname orig_mac
        for device in "$BACKUPDIR/mac_addresses"/*; do
            if [[ -f "$device" ]]; then
                devname="$(basename "$device")"
                orig_mac="$(cat "$device")"
                if ! _is_virtual_iface "$devname" && [[ -n "$orig_mac" && -e "/sys/class/net/$devname" ]]; then
                    ip link set "$devname" down 2>/dev/null || true
                    ip link set "$devname" address "$orig_mac" 2>/dev/null || true
                    ip link set "$devname" up 2>/dev/null || true
                fi
            fi
        done
    fi

    if [[ -s "$BACKUPDIR/timezone.bak" ]]; then
        local restore_timezone
        restore_timezone="$(cat "$BACKUPDIR/timezone.bak")"
        if command -v timedatectl &>/dev/null; then
            timedatectl set-timezone "$restore_timezone" 2>/dev/null || true
        fi
        if [[ -f "/usr/share/zoneinfo/$restore_timezone" ]]; then
            ln -sf "/usr/share/zoneinfo/$restore_timezone" /etc/localtime 2>/dev/null || true
            echo "$restore_timezone" > /etc/timezone 2>/dev/null || true
        fi
    fi

    if [[ -f "$BACKUPDIR/swap_was_active" ]]; then
        swapon -a 2>/dev/null || true
        rm -f "$BACKUPDIR/swap_was_active"
    fi

    # Reset all 22 module statuses & all daemon PIDs
    reset_all_module_states
    rm -rf /tmp/anon* /dev/shm/.anon* /dev/shm/.systemd_kworker_* 2>/dev/null || true

    if command -v shred &>/dev/null; then
        find "$BACKUPDIR" -maxdepth 1 -name "*.bak" -exec shred -u {} + 2>/dev/null || true
    fi
    rm -rf "$BACKUPDIR"/*.bak "$BACKUPDIR/mac_addresses"
}
