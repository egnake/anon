[Desktop Entry]
Name=Anon
Comment=Advanced OPSEC & Anonymity Framework
Exec=sh -c 'command -v pkexec >/dev/null 2>&1 && exec pkexec env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" /usr/bin/anon || exec sudo /usr/bin/anon'
Icon=/usr/share/anon/assets/icons/anon.jpg
Terminal=true
Type=Application
Categories=System;Security;Network;
StartupNotify=true
X-Kali-Package=anon
